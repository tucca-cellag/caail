# Local working artifacts, not part of the published library.
#
# /internal-docs/ is the default-deny home for working documentation. What it
# holds is deliberately not described: this file is world-readable and pushed
# irreversibly, so naming private material is disclosure whether or not the
# material itself ships. Anchored to the repo root so it names one directory
# rather than any directory of that name; site/scripts/private-paths.test.ts
# pins both the source and the exact pattern, and fails if either changes.
/internal-docs/
docs/superpowers/
docs/research/
manuscript/
tools/

# Local Claude Code worktrees
.claude/worktrees/

# Build artifacts, regenerated locally by extract_matrix_corpus.py
matrix-corpus.json
matrix-corpus/
AUDIT_REPORT.md

# Docling ingest output (docling_ingest.py), same pattern as site/caail.db: a
# local artifact rebuilt from a committed source, never committed itself. Two
# reasons it must stay out, either of which would be sufficient.
#
# Size: measured at 0.49 MB per ref over the first 47 (2026-08-12), so roughly
# 170 MB across the corpus. `du -sh docling-corpus` prints the real figure.
#
# Licensing: it holds the full text of works CAAIL may read but may not
# redistribute -- the local curation tier of CAAIL-169. Committing it to a public
# repo is exactly the publication that tier exists to avoid, and git history
# would keep it fetchable by SHA afterwards.
docling-corpus/
docling-corpus-ingest.log
docling-eval/

# macOS Finder metadata
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Local editor settings: per-developer VS Code workspace config
.vscode/

# Playwright MCP scratch output, regenerated each run
.playwright-mcp/

# Local env files. The repo is public: a pushed secret stays fetchable by SHA
# and GHArchive captures the event, so rotate rather than delete if one lands.
.env
.env.*
!.env.example

# Installed packages, at any depth. Bare rather than anchored on purpose: the workspaces
# under site/ and workers/ are not the only places one appears. A command that resolves a
# package from the repo ROOT creates one there -- an npx run from a worktree root rather
# than from site/, or a pnpm add typed one directory too high -- and nothing was ignoring
# it, so `git add -A` stages the lot. Nothing in this repo's history carries such a path:
# the one time it reached a commit, the commit was amended before it was ever pushed, which
# is a catch rather than a control. This pattern subsumes the workers/*/node_modules/ rule
# that used to sit here, which is why that one is gone. site/.gitignore keeps its own copy
# on purpose, so that workspace stays self-contained.
node_modules/

# Local wrangler state
workers/*/.wrangler/

# Per-file private companions: content that fails the docs/adr/0002 publishing
# test lives beside its public file with a .local.md / .local.mdx suffix,
# gitignored, and reaches worktrees through .worktreeinclude.
#
# .mdx is not optional here. Every file under site/src/content/docs/ is .mdx,
# and that is a directory the convention explicitly sanctions a companion in,
# so covering only .local.md would leave the commonest case committable into
# a public repo -- the leak this whole mechanism exists to prevent.
*.local.md
*.local.mdx
