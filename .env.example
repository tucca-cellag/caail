# CAAIL environment template
#
# Copy to .env at the repo root and fill in what you need. .env is gitignored;
# this file is committed, so it must never hold a real value.
#
# tucca-cellag/caail is public, and a pushed secret stays fetchable by SHA even
# after the commit is removed. If one lands, rotate it.
#
# Load before running the scripts below:
#
#   set -a; source .env; set +a


# --- Cloudflare Web Analytics -------------------------------------------------
# Read-only token: Account -> Account Analytics -> Read, scoped to one account.
# The only credential currently needed for anything.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# --- Optional: raises rate limits on two opt-in refresh scripts ----------------
# Neither runs during a normal build. Both work without these, just slower.
#
#   GITHUB_TOKEN     60 -> 5000 req/hr for fetch:awesome-lists and
#                    db:fetch-licenses. Public-repo read scope only, never a
#                    token that can write.
#   OPENALEX_MAILTO  A contact address, not a credential. Puts fetch:citations
#                    into OpenAlex's faster polite pool.
GITHUB_TOKEN=
OPENALEX_MAILTO=


# --- Ask CAAIL chat widget -----------------------------------------------------
# Set in deployment, not usually locally. Blank means the widget reports itself
# unconfigured rather than erroring.
#
# PUBLIC_ is an Astro prefix: the value is compiled into the client bundle and is
# readable by anyone loading the site. It is a URL. Never put a key behind a
# PUBLIC_ name.
PUBLIC_CAAIL_CHAT_API=

# Endpoint the two usage events post to. Also a URL, also not a secret. In CI
# this comes from the PUBLIC_CAAIL_EVENTS_API repository variable.
PUBLIC_CAAIL_EVENTS_API=


# CAAIL_E2E_PORT deliberately does NOT belong in this file. Playwright's
# reuseExistingServer silently attaches to another worktree's build, so the port
# must be verified free at the moment you run it (`lsof -ti:<port>`). A value
# persisted here goes stale and causes exactly that failure. Pass it inline:
#
#   cd site && CAAIL_E2E_PORT=4340 pnpm test:e2e
