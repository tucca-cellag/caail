---
/**
 * GetStarted — the three real install paths, split by how long the install lasts.
 *
 * ToolUniverse splits on "AI Agent User / Python Developer" because it has a package
 * to install. CAAIL has nothing to install, so that framing would be borrowed. The
 * real difference is persistence: a pasted prompt lasts one conversation, a plugin or
 * an uploaded skill persists. A page showing only the prompt leaves people pasting it,
 * getting a good answer, opening a new chat and finding it gone.
 *
 * Endpoints are GitHub URLs, not this site's. Code execution defaults to network
 * egress for package managers only, which covers GitHub but not GitHub Pages, and on
 * Team and Enterprise plans only an organisation owner can widen it. Fetching from
 * GitHub needs nobody to change a setting.
 */
import { Icon } from 'astro-icon/components';

const RAW = 'https://raw.githubusercontent.com/tucca-cellag/caail/main';
const PROMPT = `Read ${RAW}/plugin/skills/caail/SKILL.md and use CAAIL to answer questions about cellular agriculture and AI.`;

const paths = [
  {
    icon: 'ph:terminal-window-duotone',
    title: 'Claude Code, Cursor, CLI',
    life: 'Persists',
    keep: true,
    steps: ['claude plugin marketplace add tucca-cellag/caail', 'claude plugin install caail@caail'],
    note: 'About 265 tokens of always-on context.',
  },
  {
    icon: 'ph:browser-duotone',
    title: 'claude.ai',
    life: 'Persists',
    keep: true,
    steps: [`Download ${RAW}/plugin/skills/caail/SKILL.md`, 'Settings → Customize → Skills → Add → Upload skill'],
    note: 'The web app installs skills by file upload, not by URL.',
  },
];
---

<section class="gs">
  <h2 class="caail-display">Get started</h2>
  <p class="lede">
    Nothing to install, host or authenticate. CAAIL is static JSON on GitHub, so the only
    real difference between these is how long the setup lasts.
  </p>

  <div class="prompt">
    <div class="prompt-hd">
      <span><Icon name="ph:chat-teardrop-text-duotone" /> Any agent, right now</span>
      <button type="button" class="copy" data-prompt={PROMPT}>
        <span class="copy-label">Copy</span>
        <Icon name="ph:copy" class="i-copy" />
        <Icon name="ph:check" class="i-done" />
      </button>
    </div>
    <code>{PROMPT}</code>
    <p class="prompt-note">Loads for this conversation only. Nothing is installed and it will not carry over.</p>
    <output class="sr-only" aria-live="polite"></output>
  </div>

  <div class="grid">
    {paths.map((p) => (
      <div class="path">
        <p class="hdr"><Icon name={p.icon} /> {p.title}<span class="life">{p.life}</span></p>
        <ol>{p.steps.map((s) => <li><code>{s}</code></li>)}</ol>
        <p class="note">{p.note}</p>
      </div>
    ))}
  </div>
</section>

<script>
  // Progressive enhancement: without JS the prompt is still selectable text.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.gs .copy')) {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.prompt ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return; // clipboard blocked (insecure context, denied permission): leave the label alone
      }
      btn.classList.add('is-done');
      const label = btn.querySelector('.copy-label');
      if (label) label.textContent = 'Copied';
      // Announce to screen readers, which do not see a class change.
      const live = btn.closest('.prompt')?.querySelector('output');
      if (live) live.textContent = 'Setup prompt copied to clipboard';
      window.setTimeout(() => {
        btn.classList.remove('is-done');
        if (label) label.textContent = 'Copy';
        if (live) live.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .gs { margin: 2.4rem 0 0; }
  .gs h2 { font-size: 1.15rem; color: var(--caail-primary); margin: 0 0 .2rem; }
  .lede { font-size: .84rem; color: var(--caail-muted); margin: 0 0 1rem; max-width: 60ch; text-wrap: pretty; }

  /* The prompt leads: it is the zero-friction path, and the one people came for. */
  .prompt { border: 1px solid var(--caail-border); border-radius: 10px; padding: .8rem .9rem; margin: 0 0 .8rem; background: color-mix(in oklab, var(--caail-link) 3%, transparent); }
  .prompt-hd { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin: 0 0 .5rem; }
  .prompt-hd > span { display: inline-flex; align-items: center; gap: .4rem; font-size: .84rem; font-weight: 600; color: var(--caail-ink); }
  .prompt-hd [data-icon] { width: 1.15rem; height: 1.15rem; color: var(--caail-link); }
  .prompt code { display: block; font-size: .72rem; line-height: 1.55; color: var(--caail-ink); background: var(--caail-surface, #fff); border: 1px solid var(--caail-border); border-radius: 6px; padding: .5rem .6rem; overflow-wrap: anywhere; }
  .prompt-note { font-size: .73rem; color: var(--caail-muted); margin: .5rem 0 0; }

  .copy { display: inline-flex; align-items: center; gap: .35rem; flex: none; font: inherit; font-size: .74rem; font-weight: 600; color: var(--caail-link); background: var(--caail-surface, #fff); border: 1px solid var(--caail-border); border-radius: 999px; padding: .28rem .7rem; cursor: pointer; transition: border-color .15s ease-out, color .15s ease-out, background .15s ease-out; }
  .copy:hover, .copy:focus-visible { border-color: var(--caail-link); background: color-mix(in oklab, var(--caail-link) 8%, transparent); }
  .copy [data-icon] { width: .95rem; height: .95rem; }
  /* Swap the glyph on success; the label text changes too, so this is not colour-alone. */
  .copy .i-done { display: none; }
  .copy.is-done .i-copy { display: none; }
  .copy.is-done .i-done { display: inline-block; }

  .grid { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .path { border: 1px solid var(--caail-border); border-radius: 10px; padding: .8rem .9rem; transition: border-color .18s ease-out; }
  .path:hover { border-color: color-mix(in oklab, var(--caail-link) 45%, var(--caail-border)); }

  .hdr { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; font-size: .82rem; font-weight: 600; color: var(--caail-ink); margin: 0 0 .5rem; }
  .hdr [data-icon] { width: 1.1rem; height: 1.1rem; color: var(--caail-link); flex: none; }
  .life { font-size: .66rem; font-weight: 600; letter-spacing: .03em; color: var(--caail-link); border: 1px solid color-mix(in oklab, var(--caail-link) 30%, transparent); border-radius: 999px; padding: .05rem .4rem; }

  .path ol { list-style: none; counter-reset: s; padding: 0; margin: 0 0 .55rem; display: grid; gap: .35rem; }
  .path li { counter-increment: s; display: grid; grid-template-columns: 1.1rem 1fr; gap: .35rem; align-items: start; }
  .path li::before { content: counter(s); font-size: .68rem; color: var(--caail-muted); line-height: 1.7; }
  .path code { font-size: .68rem; line-height: 1.5; color: var(--caail-ink); background: color-mix(in oklab, var(--caail-border) 34%, transparent); border-radius: 5px; padding: .25rem .4rem; overflow-wrap: anywhere; }

  .note { font-size: .72rem; color: var(--caail-muted); margin: 0; line-height: 1.45; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) {
    .copy, .path { transition: none; }
  }
</style>
