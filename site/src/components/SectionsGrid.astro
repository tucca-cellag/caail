---
import { Icon } from 'astro-icon/components';
import c from '../content/data/counts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  { icon: 'lucide:file-text', count: c.papers, title: 'Papers', desc: `The full AI-method × research-area matrix over ${c.papers} references, with code & data links.`, cta: 'Open the explorer →', href: `${base}/papers/explorer/` },
  { icon: 'lucide:code', count: c.software, title: 'Software', desc: 'Open-source tools grouped by application area, framed for cell-ag use.', cta: 'Browse tools →', href: `${base}/software/` },
  { icon: 'lucide:database', count: c.databases, title: 'Databases', desc: 'Repositories, ontologies, and lookup resources for query and reference.', cta: 'Browse databases →', href: `${base}/databases/` },
  { icon: 'lucide:dna', count: c.datasets, title: 'Datasets by species', desc: `Cow, pig, chicken, fish and more: atlases, GEMs, deposits, plus benchmarks, across ${c.species} pages.`, cta: 'Pick a species →', href: `${base}/datasets/readme/` },
  { icon: 'lucide:book-open', count: c.researchAreas, title: 'Research Areas', desc: 'Deep-dive pages: media, cell engineering, bioprocess, scaffolding, sensory…', cta: 'Read the deep dives →', href: `${base}/research-areas/mediaoptimization/` },
  { icon: 'lucide:circle-play', count: c.talks, title: 'Talks & Videos', desc: 'Curated lectures and explainers, playable inline.', cta: 'Watch →', href: `${base}/talks/` },
];
---
<section class="sections" id="explore">
  <h2 class="caail-display sr">Explore the library</h2>
  <p class="sub sr sr-d1">Six collections, all cross-linked back to the canonical Markdown.</p>
  <div class="grid sr sr-d2">
    {sections.map((s) => (
      <a class="card" href={s.href}>
        <div class="top"><Icon name={s.icon} /><span class="cnt caail-display">{s.count}</span></div>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
        <span class="go">{s.cta}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .sections { margin: var(--caail-section-gap) 0 0; }
  .sections h2 { font-size: var(--caail-fs-h2); line-height: 1.1; letter-spacing: -.02em; color: var(--caail-primary); margin: 0 0 var(--caail-space-3); }
  .sub { font-size: var(--caail-fs-sm); color: var(--caail-muted); margin: 0 0 1rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--caail-space-5); }
  @media (max-width: 50rem) { .grid { grid-template-columns: 1fr; } }
  .card { display: flex; flex-direction: column; gap: .25rem; padding: 1rem; border: 1px solid var(--caail-border); border-radius: 10px; text-decoration: none; color: var(--caail-ink); }
  .card:hover { border-color: var(--caail-link); box-shadow: 0 6px 18px -14px color-mix(in oklab, var(--caail-primary) 40%, transparent); }
  .top { display: flex; align-items: center; justify-content: space-between; }
  .top [data-icon] { width: 1.7rem; height: 1.7rem; color: var(--caail-primary); }
  .cnt { font-size: 1.6rem; font-weight: 700; color: var(--caail-primary); line-height: 1; }
  .card h3 { font-size: var(--caail-fs-lg); margin: .25rem 0 0; color: var(--caail-ink); }
  .card p { font-size: var(--caail-fs-sm); color: var(--caail-muted); margin: 0; line-height: 1.45; }
  /* auto, not a fixed gap: the cards stretch to a shared row height but their
     descriptions run 2 or 3 lines, so a fixed margin left each CTA wherever its own text
     happened to end — 1486px in one card and 1466px in its neighbour, with 37px of dead
     space under it. Pushing it to the bottom lines every CTA in a row up on one edge. */
  .go { font-size: var(--caail-fs-xs); font-weight: 700; color: var(--caail-link); margin-top: auto; padding-top: .35rem; }
</style>
