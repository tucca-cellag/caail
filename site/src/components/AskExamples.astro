---
/**
 * AskExamples — "What can you ask?", answered from the real endpoints.
 *
 * Every figure is computed from the generated API at build time, so the section cannot
 * drift from the corpus, and an assumption that stops holding throws at build rather
 * than misleading on the page.
 *
 * Deliberately NOT a card grid. The homepage already carries two (six collection cards
 * plus four start-here cards); a third would be clutter, and these are question-and-
 * answer prose rather than parallel objects. A ruled list is the honest shape.
 *
 * Also deliberately no "tools used" row. ToolUniverse can show one because its answers
 * come from executing tools. CAAIL's come from fetching static JSON, and staging a
 * tool-call trace to look the part would be the overclaim this project avoids.
 */
import matrix from '../../public/api/matrix.json';
import topicsApi from '../../public/api/topics.json';
import manifest from '../../public/api/index.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function methodsIn(areaKey: string): { method: string; n: number }[] {
  return matrix.cells
    .filter((c) => c.area === areaKey && !c.emptyInCorpus)
    .map((c) => ({ method: c.method, n: c.refIds.length }))
    .sort((a, b) => b.n - a.n);
}

const media = methodsIn('media');
if (media.length === 0) throw new Error('AskExamples: media optimization has no populated cells');

const TOPIC = 'sensory-flavor';
const t = (topicsApi.index as Record<string, Record<string, unknown[]>>)[TOPIC];
if (!t) throw new Error(`AskExamples: topic "${TOPIC}" missing from the index`);

const examples = [
  {
    q: 'What has been applied to media optimization?',
    src: 'matrix.json',
    a: `${media.length} methods, densest first: ` +
      media.slice(0, 3).map((m) => `${m.method} (${m.n})`).join(', ') +
      (media.length > 3 ? `, and ${media.length - 3} more.` : '.'),
  },
  {
    q: 'I need to predict flavour from composition. What exists?',
    src: 'topics.json',
    a: `${t.papers.length} papers, ${t.databases.length} databases, ${t.software.length} tools and ` +
      `${t.datasets.length} datasets, returned together — a design question does not arrive sorted ` +
      'by content type.',
  },
  {
    q: 'How many papers are in the matrix?',
    src: 'index.json',
    a: `${manifest.counts.papersMatrixEligible} of ${manifest.counts.papersAllSections}. The rest are ` +
      'reviews and reference works, which take no matrix placement. Every count says which population ' +
      'it counted.',
  },
];
---

<section class="ask">
  <h2 class="caail-display">What can you ask?</h2>
  <p class="lede">
    Real questions against the real endpoints. Every figure below is read from the corpus
    when this page is built, so it cannot claim more than the data holds.
  </p>

  <dl class="qa">
    {examples.map((e) => (
      <div class="qa-row">
        <dt>{e.q} <code>{e.src}</code></dt>
        <dd>{e.a}</dd>
      </div>
    ))}
  </dl>

  <p class="foot">
    Corpus dated {matrix.corpusDate}. <a href={`${base}/topics/`}>Browse by subject →</a>
  </p>
</section>

<style>
  .ask { margin: var(--caail-section-gap) 0 0; }
  .ask h2 { font-size: var(--caail-fs-h2); line-height: 1.1; letter-spacing: -.02em; color: var(--caail-primary); margin: 0 0 var(--caail-space-3); }
  .lede { font-size: var(--caail-fs-base); color: var(--caail-muted); margin: 0 0 1rem; max-width: var(--caail-measure); text-wrap: pretty; }

  /* Rules, not boxes: the page already has two card grids above this one. */
  .qa { margin: 0; display: grid; }
  .qa-row { padding: var(--caail-space-5) 0; border-top: 1px solid var(--caail-border); }
  .qa-row:last-child { border-bottom: 1px solid var(--caail-border); }

  .qa dt { font-size: var(--caail-fs-base); font-weight: 600; color: var(--caail-ink); max-width: var(--caail-measure); margin: 0 0 var(--caail-space-2); line-height: 1.45; }
  .qa dt code { font-size: var(--caail-fs-xs); font-weight: 500; color: var(--caail-link); background: color-mix(in oklab, var(--caail-link) 8%, transparent); padding: .08rem .35rem; border-radius: 4px; white-space: nowrap; }
  .qa dd { font-size: var(--caail-fs-sm); color: var(--caail-muted); margin: 0; line-height: 1.55; max-width: var(--caail-measure); text-wrap: pretty; }

  .foot { font-size: var(--caail-fs-sm); color: var(--caail-muted); margin: .9rem 0 0; }
  .foot a { white-space: nowrap; }

  /* Stagger the rows as they arrive. Scroll-linked and progressively enhanced: without
     support, or with reduced motion, the rows are simply visible. Nothing is gated on a
     class that a headless renderer might never apply. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .qa-row {
        animation: qa-rise linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 26%;
      }
      /* Transform only, never opacity. animation-fill-mode holds the `from` state
         backwards, so fading from 0 leaves the row invisible wherever the timeline
         never advances — a headless render, a hidden tab, an unsupported edge. The
         content is readable at every point; motion is the enhancement, not the gate. */
      @keyframes qa-rise {
        from { transform: translateY(10px); }
        to   { transform: none; }
      }
    }
  }
</style>
