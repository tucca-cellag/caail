---
/**
 * AskExamples — worked queries against the real endpoints.
 *
 * Layout follows aiscientist.tools' "What can you ask?" band, and it is a CAROUSEL, not a
 * tab set. That distinction is the whole reason this was rebuilt. The reference renders a
 * single card, remounts it on every change so its entrance animation replays, advances it
 * on a timer with a progress bar across the top, and offers pills, chevrons and dots as
 * three ways into the same index. Implemented as WAI-ARIA tabs with `hidden` panels — as
 * this was — none of that is reachable: a `display: none` panel cannot animate, and a
 * reserved stage height sized to the tallest panel leaves the shortest one sitting in a
 * pool of dead space.
 *
 * Three structural consequences worth knowing before editing:
 *
 * 1. Cards are stacked in ONE grid cell (`grid-area: 1/1`), so the frame is exactly as
 *    tall as the tallest card and no magic reserve is needed. The previous `min-height:
 *    37rem` was a measured guess that still left ~115px of void under the shortest panel.
 * 2. Inactive cards are hidden with `visibility`, never `hidden`/`display: none` — a
 *    display-none card contributes nothing to grid sizing, which would collapse the frame
 *    and reintroduce the jump. `visibility: hidden` still sizes the grid, still leaves the
 *    a11y tree, and still blocks pointer and focus.
 * 3. The entrance is TRANSFORM-ONLY. The old tab fade animated opacity and justified it on
 *    the grounds that an accessibility audit never clicks a tab. Auto-advance destroys that
 *    argument — an audit can now sample a card mid-fade, and axe computes contrast through
 *    opacity, with `docs.yml` gating deploys on Lighthouse accessibility ≥ 0.90. Same
 *    constraint, same resolution as styles/reveal.css.
 *
 * Two deliberate departures from the reference.
 *
 * No "Tools used" row. Theirs is real — their answers come from executing tools. CAAIL's
 * come from fetching static JSON, so a tool-call trace would be a staged prop. The source
 * row names the actual endpoint instead, which is both true and more useful to anyone
 * about to query it themselves.
 *
 * The questions are written at the specificity a PhD would actually type: a named method
 * against a named problem, with the artifact they need at the end of it. "What AI work
 * exists on scaffolding" is a browsing prompt, not a research question, and answering it
 * well tells a computational biologist nothing they could act on.
 *
 * Every figure is computed from the generated API at build time. Assumptions that stop
 * holding throw here rather than misleading on the page.
 */
import { Icon } from 'astro-icon/components';
import matrix from '../../public/api/matrix.json';
import papers from '../../public/api/papers.json';
import datasetsApi from '../../public/api/datasets.json';
import { licenseTier } from '../lib/licenses';
import counts from '../content/data/counts.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Cell = (typeof matrix.cells)[number];

const byId = new Map(papers.references.map((r) => [r.id, r]));
const cite = (id: number): string => {
  const r = byId.get(id);
  if (!r) return `#${id}`;
  const who = (r.authors?.[0] ?? '').split(',')[0] || 'Unknown';
  return `${who}${r.year ? ` ${r.year}` : ''} (#${id})`;
};

/** The named method row a reader would name in a question. */
const mediaBo = matrix.cells.find((c) => c.method === 'Bayesian Optimization' && c.area === 'media')!;
if (!mediaBo) throw new Error('AskExamples: Bayesian Optimization × media cell missing from matrix.json');

/* The tier is DERIVED, not stored — papers.json carries the raw OpenAlex licence string
   and nothing else. Reading a `licenseTier` field off it silently yielded 0, because the
   field does not exist. Same classifier the /licenses/ hub uses, so the homepage figure
   and the hub can never disagree. */
const redistributable = papers.references.filter((r) => {
  const tier = licenseTier(r.license);
  return tier === 'permissive' || tier === 'copyleft';
}).length;
/* Populations, each labelled by what it counted.

   This used to render one figure: papers + software + databases + datasets, presented as
   "N curated resources". That sum overstates curation in two directions at once. The paper
   total is every entry across all six sections, not the matrix-eligible subset, and the
   dataset total is mostly per-study inventory rows rather than curated entries. Summing
   four populations that were counted by four different rules produces a number about
   nothing, and it is the largest number on the band, so it is the one a reader carries away.

   CLAUDE.md states the rule directly: "345 papers" and "papers in the matrix" are different
   numbers, so label every count with the population it counted. The lede names the parts and
   no longer offers a total.

   Every figure is read from the same endpoints an agent would read, and the two partitions
   are asserted below. A hand-typed number beside a machine-derived one is this repo's most
   expensive recurring defect; the mitigation is to derive it or to fail when the two
   disagree, and this does both. */
const primaryPapers = papers.references.filter((r) => r.isPrimary).length;
const reviewPapers = papers.references.filter((r) => r.section === 'Reviews & Perspectives').length;
const referenceWorkPapers = papers.references.length - primaryPapers - reviewPapers;
const curatedDatasets = datasetsApi.entries.length;
const inventoryRows = datasetsApi.inventory.length;

/* Partition guards. These fire at build time, so a section rename in Papers.md or a new
   dataset page shape breaks the build instead of quietly reallocating readers between two
   populations the page names separately. */
if (primaryPapers + reviewPapers + referenceWorkPapers !== counts.papers) {
  throw new Error(
    `AskExamples: paper populations do not partition: ${primaryPapers} primary + ` +
      `${reviewPapers} reviews + ${referenceWorkPapers} reference-work ≠ ${counts.papers} total`,
  );
}
if (curatedDatasets + inventoryRows !== counts.datasets) {
  throw new Error(
    `AskExamples: dataset populations do not partition: ${curatedDatasets} curated + ` +
      `${inventoryRows} inventory ≠ ${counts.datasets} total`,
  );
}

/* ---- Card 1: the bovine substrate a planned timecourse would have to join ----------------
   Every figure below is read from datasets.json rather than named, because the whole point of
   the card is that the inventory is deeper than a browsing reader would guess. `columns` exists
   only on inventory rows (curated entries have no table), hence the optional access. */
type InventoryRow = { page: string; columns?: Record<string, string> };
const cowInventory = (datasetsApi.inventory as InventoryRow[]).filter((r) => r.page === 'Cow');
const cowCurated = datasetsApi.entries.filter((e) => e.page === 'Cow');
const cowTotal = cowInventory.length + cowCurated.length;
const col = (r: InventoryRow, k: string) => r.columns?.[k] ?? '';
const cowTranscriptomic = cowInventory.filter((r) => /rna-seq/i.test(col(r, 'Type')));
/* The single differentiation timecourse, matched on its harvest grid rather than its accession,
   so a re-deposit under a new accession does not silently drop the card's central claim. */
const cowTimecourse = cowInventory.find((r) => /0\/24\/48\/72\/96/.test(col(r, 'Description')));
/* The bulk comparator, and the reason this card has a tension rather than a recommendation.
   An earlier version said "match the trigger and you can join it" one row after saying the
   timecourse cannot be joined at all, which is a contradiction: the timecourse IS the serum-free
   deposit. The two things worth matching sit in different deposits, and only one of them is an
   assay you can pool bulk libraries with. Matched on the trigger wording rather than the
   accession, for the same reason as above. */
const cowBulkComparator = cowInventory.find(
  (r) => /^rna-seq/i.test(col(r, 'Type')) && /serum-starvation|20%→2%/i.test(col(r, 'Description')),
);
/* The embargo is the card's checkable catch: the obvious regulatory reference cannot actually be
   used yet. If the deposit opens up, this throws rather than shipping a stale warning. */
const cowEmbargoed = cowInventory.find((r) => /embargoed/i.test(col(r, 'Description')));
if (!cowTimecourse || !cowBulkComparator || !cowEmbargoed || cowTranscriptomic.length < 3) {
  throw new Error(
    'AskExamples card 1: expected a 0/24/48/72/96 h bovine timecourse, a bulk serum-starvation ' +
      'comparator, an embargoed reference deposit, and 3+ transcriptomic Cow rows; got ' +
      `timecourse=${!!cowTimecourse} bulk=${!!cowBulkComparator} embargo=${!!cowEmbargoed} ` +
      `rnaSeq=${cowTranscriptomic.length}`,
  );
}
/* The tension only exists while the timecourse is an assay you cannot pool with. If a bulk
   timecourse is ever deposited the card's whole argument collapses into "use that one", so this
   asserts the premise rather than leaving it to be noticed. */
if (/^(bulk )?rna-seq$/i.test(col(cowTimecourse, 'Type'))) {
  throw new Error(
    'AskExamples card 1: the timecourse is now bulk RNA-seq, so the assay-vs-timing tension the ' +
      'card is built on no longer holds. Rewrite the card.',
  );
}

/* ---- Card 2: where the model-plus-loop work is actually filed ----------------------------
   This card previously led on "none of the 10 is ALSO tagged metabolic modeling, and all 10 are
   tagged, so the gap is in their content and not in our coverage". That verification does not hold
   and the claim has been removed.

   Two reasons it fails. Topic tags mark a paper's PRIMARY SUBJECT, not the methods it uses: the
   27 papers tagged metabolic-modeling are GEM reconstructions and flux-balance work, so asking
   whether a media-optimization paper is "also tagged metabolic modeling" asks whether it is
   primarily a metabolic-modeling paper, which is close to tautologically no. And tagging is far
   too sparse to carry an absence claim: 53 papers in the corpus have no tags at all and 131 have
   exactly one, so "every paper here is tagged" is satisfied by a single obvious label and says
   nothing about what was considered. Ref #249 couples solution thermodynamics to a BO media loop
   and would have falsified the old headline on its own.

   Everything below is read from matrix placement and the code/data flags, both structural, and no
   claim here depends on a topic tag. The adjacency is DERIVED by title and area rather than named,
   so it cannot silently point at a paper that has moved column. */
const modelLoopAdjacent = papers.references
  .filter(
    (r) =>
      /genome-scale|metabolic network/i.test(r.title) &&
      !(r.areas ?? []).includes('media') &&
      (r.methods ?? []).some((m) => /Bayesian Optimization|Active Learning/i.test(m)),
  )
  .sort((a, b) => (b.citedByOpenAlex ?? 0) - (a.citedByOpenAlex ?? 0))
  .slice(0, 2);
const mediaBoBoth = papers.references.filter(
  (r) => mediaBo.refIds.includes(r.id) && r.hasCode && r.hasData,
);
if (modelLoopAdjacent.length < 2) {
  throw new Error(
    `AskExamples card 2: expected 2+ design-loop papers on genome-scale or metabolic-network work ` +
      `outside the media column; found ${modelLoopAdjacent.length}`,
  );
}

/* ---- Card 3: the coverage map, read on two axes not one ---------------------------------
   Cell size alone cannot separate "4 papers and live" from "4 papers and untouched since 2024",
   and for a multi-year commitment those are opposite bets. The recency split is the safer signal
   because it compares indexed papers against each other rather than against the field, which
   CAAIL has not measured and says so in its own scopeNote. */
const yearById = new Map(papers.references.map((r) => [r.id, r.year]));
const recentIn = (c: Cell) =>
  c.refIds.filter((id) => (yearById.get(id) ?? 0) >= 2024).length;
const populated = matrix.cells.filter((c) => !c.emptyInCorpus);
const crowded = populated
  .filter((c) => c.refIds.length >= 10)
  .sort((a, b) => b.refIds.length - a.refIds.length);
/* Enough groundwork to stand on, not so much that it is crowded, and demonstrably still moving. */
const goldilocks = populated
  .filter((c) => c.refIds.length >= 3 && c.refIds.length <= 6 && recentIn(c) >= 3)
  .sort((a, b) => recentIn(b) - recentIn(a));
const stalled = populated
  .filter((c) => c.refIds.length >= 3 && recentIn(c) === 0)
  .sort((a, b) => b.refIds.length - a.refIds.length);
/* The finding the card is built on, and it is NOT the one you first reach for. "Crowded cells are
   all AI-method columns" is false: Ensemble Learning × sensory is the joint-largest cell in the
   whole matrix and Bayesian Optimization × media also clears 10, both cell-ag applications. This
   guard exists because that wrong version was written first and the build caught it.

   What actually separates the crowded cells is RECENCY. The tooling and evaluation pile-ups are
   almost entirely post-2024; the crowded application cells are long-standing literatures where
   recent work is a minority. So "crowded" means two different things, and they imply opposite
   moves for someone choosing a multi-year direction. */
const share = (c: Cell) => recentIn(c) / c.refIds.length;
const crowdedRush = crowded.filter((c) => share(c) >= 0.6);
const crowdedMature = crowded.filter((c) => share(c) < 0.6);
if (!goldilocks.length || !stalled.length || !crowdedRush.length || !crowdedMature.length) {
  throw new Error(
    `AskExamples card 3: expected crowded cells of both kinds plus goldilocks and stalled cells; ` +
      `got rush=${crowdedRush.length} mature=${crowdedMature.length} ` +
      `goldilocks=${goldilocks.length} stalled=${stalled.length}`,
  );
}

/* ---- Card 5: sensory, and what a small-n asker can actually build on ----------------------
   DRAFTED FOR REVIEW, not settled. It is here so all five can be compared rendered rather than in
   a working file, and the open question is whether it ships at all. See the note below its entry.

   The sensory column is the corpus's most classical-ML-heavy area, which for a 40-sample asker is
   the answer rather than a disappointment. Everything here is cell counts and licence tiers, both
   structural. */
const sensoryCells = matrix.cells
  .filter((c) => c.area === 'sensory' && !c.emptyInCorpus)
  .sort((a, b) => b.refIds.length - a.refIds.length);
const sensoryTop = sensoryCells[0];
const sensoryDeep = sensoryCells.filter((c) => /Deep Learning|CNN|GNN/i.test(c.method));
const sensoryClassical = sensoryCells.filter((c) =>
  /Ensemble|SVM|Chemometrics|Nearest Neighbors|Linear/i.test(c.method),
);
const nRefs = (cs: Cell[]) => new Set(cs.flatMap((c) => c.refIds)).size;
const sensoryIds = new Set(sensoryCells.flatMap((c) => c.refIds));
const sensoryRefs = papers.references.filter((r) => sensoryIds.has(r.id));
const sensoryBoth = sensoryRefs.filter((r) => r.hasCode && r.hasData).length;
const corpusBoth = papers.references.filter((r) => r.hasCode && r.hasData).length;
if (!sensoryTop || nRefs(sensoryClassical) <= nRefs(sensoryDeep)) {
  throw new Error(
    `AskExamples card 5: the card rests on sensory being classical-ML-heavy; got classical=` +
      `${nRefs(sensoryClassical)} deep=${nRefs(sensoryDeep)}`,
  );
}

/* ---- Card 4: what may leave the network ---------------------------------------------------
   The question asks two things: what may be redistributed versus only read internally, and what
   needs clearing the day the tool goes customer-facing. It asks nothing about citation weight, so
   this card reports neither.

   An earlier version led on "of the 8 works cited 1,000+ times, 1 is redistributable". That was
   cut for two reasons. It answered a question the card does not pose; and the anti-correlation it
   implied does not survive the corpus. Median citations by tier run permissive 29.5, unknown 20,
   copyleft 17, restricted 15.5, so redistributable work is if anything the MORE cited. The
   apparent conflict lived entirely in an n=8 tail behind a threshold picked after seeing the data.

   `unknown` means no machine-readable licence was recorded, NOT that permission is denied. Keeping
   those apart is the whole point: conflating them is the same error as treating is_oa as a
   redistribution grant, running the other way. */
const tierOf = (r: { license: string | null }) => licenseTier(r.license);
const unrecorded = papers.references.filter((r) => tierOf(r) === 'unknown').length;
const restricted = papers.references.filter((r) => tierOf(r) === 'restricted').length;
const needsClearing = unrecorded + restricted;
const openAccess = papers.references.filter((r) => r.isOa).length;
if (redistributable + needsClearing !== papers.references.length) {
  throw new Error(
    `AskExamples card 4: licence tiers do not partition the corpus: ${redistributable} ` +
      `redistributable + ${needsClearing} needing clearance ≠ ${papers.references.length}`,
  );
}

/* Questions are built on cross-cutting themes found by sweeping all 112 entries in GFI's
   solutions database (gfi.org/solutions, 12 pages, cross-checked against its public REST
   endpoint). Each spans more than one axis on purpose: the matrix says what has been
   tried, the subject index says what exists to work with, and the licence axis says what
   you may do with it. A question answerable by one lookup is not worth a worked example.

   ATTRIBUTION lives in the section credit and in the ANSWERS, never in the questions.
   Three of these used to open "GFI names…" / "GFI lists…" / "GFI notes…", which read as
   GFI's agenda rather than as something a researcher would type, and put three near
   identical openings in a row in what is now a rotating carousel. The one place the link
   genuinely pays off — that the paper GFI cites as prior art for media formulation is
   already ref #3 with code attached — is stated in Q1's answer, where it lands as evidence
   instead of preamble. The observation that separately-funded priorities share one
   underlying problem is ours, not GFI's; GFI lists them as unlinked entries.

   VOICE is two audiences on purpose, not by accident. Q1–Q3 are one researcher in the
   first person; Q4 is a team shipping something, because the redistribution trap only
   bites when a tool leaves your network, and "Building on it" is the pill that signals
   the shift. */
const examples = [
  {
    id: 'design',
    tab: 'Designing to integrate',
    icon: 'lucide:dna',
    label: 'Experiment design × existing deposits',
    q:
      'I am planning an RNA-seq timecourse on primary bovine satellite cells through differentiation, ' +
      'budget for about 12 libraries. I would like this to be integrable with existing data rather ' +
      'than standing alone. Which public datasets could mine realistically be combined with, and what ' +
      'do I need to match in the design (timepoints, depth, annotation build) for that to be possible?',
    src: ['datasets.json', 'papers.json'],
    head: `Across the ${cowTotal} indexed bovine datasets, the best timepoint design and the deposit worth pooling with are not the same one`,
    rows: [
      { k: 'The only real timecourse, wrong assay', v: `${col(cowTimecourse, 'Data').replace(/\[`|`\]\(.*/g, '')} harvests at 0/24/48/72/96 h, in serum-free differentiation medium, but it is single-nucleus. Copy its grid and compare at pseudobulk: 5 timepoints × 2 replicates fits your 12 libraries with two spare` },
      /* NOT "the only poolable comparator": GSE330550, PRJNA790762 and GSE262758 are bulk-inclusive
         differentiation deposits too. What is actually unique about this one is that it spans both
         triggers, which is the claim the tail rests on, so the row now says that instead. */
      { k: 'The comparator that spans both triggers', v: `${col(cowBulkComparator, 'Data').replace(/\[`|`\]\(.*/g, '')} is bulk and is the only deposit running a 20%→2% FBS starvation arm alongside an SFM vs 20% FBS comparison. It is a contrast rather than a series, so pooling with it means matching that contrast, not the timing` },
      { k: 'Check before you rely on it', v: 'The bovine FAANG epigenome atlas is the obvious annotation reference and its new deposits are embargoed until journal acceptance' },
    ],
    tail:
      'You cannot match both at once, and choosing which comparability you want is the decision this ' +
      'question actually feeds. The bulk comparator is the bridge, since it is the one deposit that ' +
      'runs both a serum-free and a serum-starvation arm. None of that is reachable by browsing: it ' +
      'needs the assay types, the trigger each one used, and the data-availability line that says the ' +
      'best annotation reference cannot be used yet.',
  },
  {
    id: 'media',
    tab: 'Media & metabolism',
    icon: 'lucide:flask-conical',
    label: 'Media optimization × metabolic modeling',
    q:
      'We are trying to cut the cost of our serum-free medium and have reached the point where ' +
      'one-factor-at-a-time screening has stopped paying. I have a draft genome-scale model for our ' +
      'species but no experience closing the loop between a model and a screen. What work couples a ' +
      'metabolic model to an experimental design loop, and what did those groups actually have to ' +
      'measure to make the model useful?',
    /* topics.json was dropped from this list with the tag-based claim it supported. The row is a
       statement about which endpoints answer the question, so it has to track the answer. */
    src: ['matrix.json', 'papers.json'],
    /* "The model-plus-loop work is indexed one column over" was the first wording, and its definite
       article claims an exhaustive search this does not perform: the adjacency is a title match over
       two method rows. Softened to what was actually established. */
    head: `The closest indexed prior art sits one column over from where you would look, outside media optimization`,
    rows: [
      { k: 'The cell you would search', v: `Bayesian Optimization × Media Optimization: ${mediaBo.refIds.length} papers, including ${cite(3)}, the paper GFI cites as prior art for media formulation` },
      { k: 'Where the coupling actually sits', v: `${modelLoopAdjacent.map((r) => `${cite(r.id)} in ${r.areas.join(' and ')}`).join('; ')}: genome-scale and metabolic-network work driven by a design loop, filed under other areas` },
      { k: 'What you could actually re-run', v: `${mediaBoBoth.length} of the ${mediaBo.refIds.length} links both code and a data deposit${mediaBoBoth.length ? ` (${mediaBoBoth.map((r) => cite(r.id)).join(', ')})` : ''}, which is what closing the loop yourself requires` },
    ],
    tail:
      'The measurement burden each group carried is in their methods sections, not in any metadata ' +
      'field, which is why this ends in three papers to read rather than a filter. Read the scope ' +
      'precisely: this is where the coupling is indexed, not a claim that nobody has done it in media.',
  },
  {
    id: 'coverage',
    tab: 'Coverage & gaps',
    icon: 'lucide:grid-3x3',
    label: 'Method coverage × research area',
    q:
      'I am deciding where to put a student for the next two years. Across these methods and research ' +
      'areas, where is there enough groundwork to build on but not so much that it is crowded, and ' +
      'what would I read to sanity-check that?',
    src: ['matrix.json', 'papers.json', 'taxonomy.json'],
    /* The coverage map is the one thing here no search engine has, and reading it on cell size
       alone is the trap. A cell with four papers and none since 2024 sorts identically to a cell
       with four papers and three of them recent, and for a multi-year commitment those are
       opposite bets. So the card reports density AND recency, and leads with the structural
       finding rather than a ranking.

       Scope wording matters as much as it does on any null: 107 empty cells describes what CAAIL
       indexes, not what exists. index.json's own scopeNote says so. The recency split is the safer
       signal precisely because it compares indexed papers against each other. */
    head: `${matrix.populatedCells} of ${matrix.totalCells} cells hold anything at all, and "crowded" turns out to mean two different things`,
    rows: [
      /* The first two rows are classified on the SHARE of refs since 2024, not the count, while the
         cells display counts. Left implicit, that read as a contradiction: the mature row shows a
         cell with 6 recent papers beside a "still moving" row showing cells with 5, 4 and 3. The
         labels now name size first and state the proportion, so the axis being compared is on the
         page rather than in the classifier. */
      { k: 'Crowded, and mostly since 2024', v: `${crowdedRush.slice(0, 2).map((c) => `${c.method} × ${c.area} (${recentIn(c)} of ${c.refIds.length})`).join('; ')}: a pile-up you would be joining late` },
      { k: 'Crowded, but mostly before it', v: `${crowdedMature.map((c) => `${c.method} × ${c.area} (${recentIn(c)} of ${c.refIds.length})`).join('; ')}: large because they are long-established, not because they are moving` },
      { k: 'Small enough to enter, still moving', v: `${goldilocks.slice(0, 3).map((c) => `${c.method} × ${c.area} (${recentIn(c)} of ${c.refIds.length})`).join('; ')}` },
      { k: 'Small, and stopped', v: `${stalled.slice(0, 3).map((c) => `${c.method} × ${c.area} (0 of ${c.refIds.length})`).join(', ')}: groundwork exists and nothing has landed since 2024` },
    ],
    tail:
      'Cell size alone collapses all four rows into one ranking, which is why the count on its own ' +
      'would mislead you. The judgement the numbers inform without making is the last row: abandoned ' +
      'because it did not work, or unfashionable but sound. Read the Taxonomy entry so you know the ' +
      'cell means what you think, then read the three papers.',
  },
  {
    id: 'build',
    tab: 'Building on it',
    icon: 'lucide:layers',
    label: 'Internal tooling × licensing',
    q:
      'Much precompetitive work in this field is re-derived privately and never published, so sparse ' +
      'literature does not mean unstudied. We want an internal assistant over what IS published, and ' +
      'it may go customer-facing later. What may we redistribute versus only read internally, and what ' +
      'would need licensing separately the day it leaves our network?',
    src: ['papers.json'],
    /* The two populations are NESTED, not disjoint: every redistributable paper is also open
       access (verified, zero outside), so "N redistributable against M free to read" invited the
       reader to treat M as the other group. The third row always had the correct nested framing,
       so the head was contradicting its own card. */
    head: `Of the ${openAccess} papers you may freely read, only ${redistributable} may also be redistributed`,
    rows: [
      { k: 'Internally, the answer is most of it', v: 'What your organisation may lawfully read, it may generally index for itself. The tier binds on publishing, not on working, so the internal assistant is the easy half' },
      { k: 'The day it leaves the network', v: `${needsClearing} works need clearing one at a time: ${unrecorded} record no machine-readable licence at all, and ${restricted} are explicitly non-commercial or no-derivatives` },
      { k: 'The filter that looks right and is not', v: `Filtering on open access returns ${openAccess}, overstating what you may republish by ${openAccess - redistributable} works. Unrecorded means nobody wrote the terms down, not that permission was refused` },
    ],
    tail:
      'Free to read is not permission to republish, and the two get conflated in both directions: ' +
      `treat is_oa as a grant and you ship ${openAccess - redistributable} works you had no licence ` +
      `for, treat unrecorded as forbidden and you discard ${unrecorded} you could probably clear by asking.`,
  },
  /* DRAFTED FOR REVIEW. Whether this ships, and whether it displaces another card, is an open
     curator decision. Two things to weigh.

     It is the only card covering the sensory column, which the subject-spread rule wanted and
     which nothing else here touches. But adding it takes the carousel to five, and the dwell is
     16s per card, so the full cycle becomes 80 seconds.

     Its original second half asked whether a spectral or compound database could be wrapped as a
     tool, and answered that only 2 of the 23 sensory databases are permissive while the tooling is
     overwhelmingly open. That row was cut here: it is a strong finding but it lands the same
     licence punchline as the card above it, and two adjacent cards making one point reads as
     repetition in a rotating band. The finding is preserved in the working notes. */
  {
    id: 'sensory',
    tab: 'Flavor & sensory',
    icon: 'lucide:donut',
    label: 'Sensory prediction × small-n reality',
    q:
      'We run a small cultured-pork line and have GC-MS volatile panels plus trained-panel scores ' +
      'for about 40 samples, nowhere near enough to train on. Before I commit to another year of ' +
      'panel sessions, which approaches have actually predicted sensory outcomes from instrumental ' +
      'measurements in meat, and what did those groups need in sample counts and reference ' +
      'standards to make it work?',
    src: ['matrix.json', 'papers.json'],
    head: `40 samples is not the shortfall it looks like: the indexed sensory work runs on classical small-n methods, not deep learning`,
    rows: [
      { k: 'What the field actually uses', v: `${nRefs(sensoryClassical)} papers across the ensemble, SVM, chemometrics and nearest-neighbour rows, against ${nRefs(sensoryDeep)} on deep learning, CNN and GNN combined` },
      { k: 'The largest single cell', v: `${sensoryTop.method} × sensory holds ${sensoryTop.refIds.length} papers, joint-largest in the whole matrix: the methods are settled enough that your question is about sample design, not architecture` },
      { k: 'Nobody\'s panel data is waiting for you', v: `${sensoryBoth} of the ${sensoryRefs.length} sensory papers link both code and a data deposit. That is the corpus norm rather than a sensory failing (${corpusBoth} of ${papers.references.length} overall), but it means there is no baseline to bootstrap from and your 40 samples are the baseline` },
    ],
    tail:
      'What each group had to measure is in their methods sections, which is the reading this ' +
      'question ends in. The useful part is that the answer changes the plan from "collect more ' +
      'before starting" to "start with what the small-n literature already supports".',
  },
];---

<section class="ask" id="ask">
  <div class="hd sr">
    {/* Doubles as the HomeRail label for this section — keep the two identical, and see
        the note in HomeRail.astro for why the rail derives from the eyebrow rather than
        from the h2. Guarded by homepage-agent.spec.ts. */}
    <p class="eyebrow"><span class="bar" aria-hidden="true"></span>What you can ask</p>
    <h2 class="caail-display">Ask something specific</h2>
    <p class="lede">
      Real questions against the real endpoints. Behind them: {primaryPapers} primary-research
      papers in the matrix, plus {reviewPapers} reviews and {referenceWorkPapers} reference-work
      chapters; {counts.software} tools and {counts.databases} databases; and {curatedDatasets}
      curated dataset entries over {inventoryRows} per-study deposits. Indexed across
      {matrix.methods.length} AI methods and {matrix.areas.length} research areas.
    </p>
    <p class="sub">
      These are what the endpoints return, not finished answers; your agent reasons on top of
      them. Every figure is read from the corpus when this page is built, so nothing here is
      illustrative. Questions draw on cross-cutting themes across all 112 entries in
      <a href="https://gfi.org/solutions/">GFI's solutions database</a>.
    </p>
  </div>

  <div class="pills sr sr-d1">
    {examples.map((e, i) => (
      <button type="button" class="pill" data-pill aria-pressed={i === 0 ? 'true' : 'false'}>
        <Icon name={e.icon} />{e.tab}
      </button>
    ))}
  </div>

  {/* Announces the change for screen readers, which see neither the pill state nor the
      card swap. Deliberately announces the short label, not the four-line question —
      re-reading a paragraph on every advance is punishing to listen to. */}
  <p class="vh" aria-live="polite" aria-atomic="true" data-live></p>

  <div class="stack sr sr-d2">
    {/* Full width with no JS, where it simply reads as the card's accent edge. With JS it
        animates 0 → 1 across the dwell, and its `animationend` is what advances the
        carousel — one clock instead of two, so pausing the animation pauses the advance
        with no elapsed-time bookkeeping to drift. */}
    <div class="prog" data-prog aria-hidden="true"></div>

    {examples.map((e, i) => (
      <article class="card" data-card data-off={i === 0 ? null : ''}>
        <div class="chead">
          <p class="plabel"><Icon name={e.icon} />{e.label}</p>
          <p class="q">{e.q}</p>
        </div>

        <div class="csrc">
          <span>Answered from</span>
          {e.src.map((s) => <code>{s}</code>)}
        </div>

        <div class="cbody">
          <p class="head">{e.head}</p>
          <ul class="rows">
            {e.rows.map((r) => (<li><strong>{r.k}</strong><span>{r.v}</span></li>))}
          </ul>
          <p class="tail">{e.tail}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="ctrls sr sr-d3">
    <button type="button" class="arrow" data-prev aria-label="Previous example">
      <Icon name="lucide:chevron-left" />
    </button>
    <div class="dots">
      {examples.map((e, i) => (
        <button type="button" class="dot" data-dot aria-label={`Show example ${i + 1} of ${examples.length}: ${e.tab}`} aria-current={i === 0 ? 'true' : 'false'}></button>
      ))}
    </div>
    <button type="button" class="arrow" data-next aria-label="Next example">
      <Icon name="lucide:chevron-right" />
    </button>
  </div>

  <p class="foot sr sr-d4">
    <a class="more" href={`${base}/papers/explorer/`}>Open the Papers Explorer →</a>
    {/* Beta sits next to the corpus date because the two qualify different things and a
        reader needs both: the date bounds WHEN this was true, the status bounds HOW
        settled it is. Deliberately quiet, because the risk it flags is small — the counts
        and metadata are firm and a placement is a real claim about the paper; the
        re-verification against full texts tightens precision rather than establishing
        trust. Agents get the same calibration via `status` / `placementNote` in
        matrix.json. */}
    <span class="dated"><span class="beta">beta</span>Corpus dated {matrix.corpusDate}</span>
  </p>
</section>

<script>
  /**
   * Carousel controller. Progressive enhancement in the strict sense: without this the
   * first card is already rendered and readable, the accent bar is a static edge, and the
   * controls are inert buttons rather than broken ones.
   */
  const root = document.querySelector<HTMLElement>('.ask');
  const pills = [...(root?.querySelectorAll<HTMLButtonElement>('[data-pill]') ?? [])];
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-card]') ?? [])];
  const dots = [...(root?.querySelectorAll<HTMLButtonElement>('[data-dot]') ?? [])];

  if (root && cards.length > 1) {
    const prog = root.querySelector<HTMLElement>('[data-prog]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    let at = 0;
    // Auto-advance is off under reduced motion, and switches off permanently the moment
    // anyone touches a control — once a reader has expressed intent, moving the content
    // out from under them is hostile. It also pauses on hover and on focus-within, which
    // together are the pause mechanism WCAG 2.2.2 asks of auto-moving content.
    let auto = !reduce.matches;

    const show = (n: number, announce: boolean) => {
      at = (n + cards.length) % cards.length;
      cards.forEach((c, i) => {
        if (i === at) c.removeAttribute('data-off');
        else c.setAttribute('data-off', '');
        // Never `hidden`: display:none removes the card from grid sizing and the frame
        // would collapse to the active card's height, jumping on every change.
        c.classList.toggle('is-enter', i === at && announce);
      });
      pills.forEach((p, i) => p.setAttribute('aria-pressed', String(i === at)));
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === at)));
      if (announce) live.textContent = `${pills[at]?.textContent?.trim() ?? ''}: example ${at + 1} of ${cards.length}`;
      restart();
    };

    const restart = () => {
      prog.classList.remove('run');
      if (!auto) return;
      // The class change only takes effect once the removal has been flushed; without the
      // forced reflow the animation is never re-run and the carousel stalls after one card.
      void prog.offsetWidth;
      prog.classList.add('run');
    };

    const stopAuto = () => {
      auto = false;
      prog.classList.remove('run');
      root.setAttribute('data-manual', '');
    };

    prog.addEventListener('animationend', () => { if (auto) show(at + 1, true); });

    pills.forEach((p, i) => p.addEventListener('click', () => { stopAuto(); show(i, true); }));
    dots.forEach((d, i) => d.addEventListener('click', () => { stopAuto(); show(i, true); }));
    root.querySelector('[data-prev]')?.addEventListener('click', () => { stopAuto(); show(at - 1, true); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { stopAuto(); show(at + 1, true); });

    const pause = () => { prog.style.animationPlayState = 'paused'; };
    const play = () => { prog.style.animationPlayState = ''; };
    root.addEventListener('pointerenter', pause);
    root.addEventListener('pointerleave', play);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', play);

    reduce.addEventListener('change', () => { if (reduce.matches) stopAuto(); });
    restart();
  }
</script>

<style>
  .ask { margin: var(--caail-section-gap) 0 0; }

  /* Centred header, matching the reference band. The measure is constrained so the lede
     wraps to two lines rather than one very long one. */
  .hd { text-align: center; max-width: 42rem; margin: 0 auto var(--caail-space-6); }
  .eyebrow {
    display: inline-flex; align-items: center; gap: .55rem;
    font-size: var(--caail-fs-xs); letter-spacing: .18em; text-transform: uppercase;
    font-weight: 600; color: var(--caail-muted); margin: 0 0 var(--caail-space-3);
  }
  .bar { display: block; width: 2px; height: .85rem; background: var(--caail-link); border-radius: 2px; }
  .ask h2 { font-size: var(--caail-fs-h2); line-height: 1.1; letter-spacing: -.02em; color: var(--caail-primary); margin: 0 0 var(--caail-space-3); text-wrap: balance; }
  .lede { font-size: var(--caail-fs-lg); color: var(--caail-ink); margin: 0 0 var(--caail-space-2); text-wrap: pretty; }
  .sub { font-size: var(--caail-fs-sm); color: var(--caail-muted); margin: 0; text-wrap: pretty; }

  /* Visually hidden but present for assistive tech. Not `visibility`/`display`, either of
     which would take it out of the a11y tree and silence the live region entirely. */
  .vh {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; margin: -1px; padding: 0; border: 0;
  }

  /* Icon pills, centred. Active is filled rather than outlined so the connection to the
     card's accent edge below is unmistakable. */
  .pills { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--caail-space-2); margin: 0 0 var(--caail-space-6); }
  .pill {
    display: inline-flex; align-items: center; gap: .4rem;
    font: inherit; font-size: var(--caail-fs-sm); font-weight: 600;
    color: var(--caail-muted); background: var(--caail-bg);
    border: 1px solid var(--caail-border); border-radius: 999px;
    padding: .45rem 1rem; cursor: pointer;
    transition: color .15s ease-out, border-color .15s ease-out, background .15s ease-out;
  }
  .pill [data-icon] { width: 1.05rem; height: 1.05rem; }
  .pill:hover { color: var(--caail-link); border-color: var(--caail-link); }
  .pill[aria-pressed='true'] {
    color: var(--caail-link);
    border-color: var(--caail-link);
    background: color-mix(in oklab, var(--caail-link) 9%, transparent);
  }

  /* THE STACK. Every card occupies the same grid cell, so the frame is exactly as tall as
     the tallest card — no reserved height to measure, and none to go stale when the copy
     is edited. The previous `min-height: 37rem` was measured against four panels of
     524/531/549/579px and still left ~115px of void under the shortest. */
  .stack {
    position: relative; display: grid;
    border: 1px solid var(--caail-border); border-radius: 12px;
    overflow: hidden; background: var(--caail-bg);
  }
  .card { grid-area: 1 / 1; display: flex; flex-direction: column; min-width: 0; }
  /* `visibility`, never `hidden`/`display: none`. A display-none card contributes nothing
     to grid track sizing, so the frame would collapse to the active card and jump on every
     change — which is the entire thing the stack exists to prevent. visibility:hidden
     still sizes the grid while leaving the a11y tree and blocking pointer and focus. */
  .card[data-off] { visibility: hidden; }

  /* Progress bar: inside the radius rather than on the border. A 3px top BORDER met the
     1px side borders at the corners and left a visible notch on each. */
  .prog {
    position: absolute; inset: 0 0 auto 0; z-index: 2; height: 3px;
    background: var(--caail-link); transform-origin: 0 50%;
  }
  .prog.run { animation: prog 16s linear forwards; }
  @keyframes prog { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* TRANSFORM ONLY — no opacity, and this one is load-bearing. The old tab fade animated
     opacity and argued it was safe because an audit never clicks a tab. Auto-advance ends
     that argument: axe computes contrast through opacity, and a card sampled mid-fade
     reports a bogus violation against the Lighthouse ≥0.90 deploy gate. Staggering the
     three regions gives the change plenty of legibility without it. */
  .card.is-enter > * { animation: card-in .5s cubic-bezier(.16, 1, .3, 1) both; }
  .card.is-enter .csrc { animation-delay: .06s; }
  .card.is-enter .cbody { animation-delay: .12s; }
  @keyframes card-in { from { transform: translateY(14px); } to { transform: none; } }

  /* Tinted, rule-separated regions, as the reference does. This is also what stops the
     slack under a short card reading as a hole: the leftover falls inside a bounded body
     panel rather than inside one undifferentiated box. */
  .chead { padding: var(--caail-space-6); background: var(--caail-surface); border-bottom: 1px solid var(--caail-border); }
  .csrc { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; padding: var(--caail-space-4) var(--caail-space-6); border-bottom: 1px solid var(--caail-border); font-size: var(--caail-fs-sm); color: var(--caail-muted); }
  .cbody { display: flex; flex-direction: column; padding: var(--caail-space-6); flex: 1; }
  /* Absorbs the stack's slack, so the closing line sits at the foot of a short card
     rather than leaving the void beneath it. */
  .cbody .tail { margin-top: auto; padding-top: var(--caail-space-5); }

  /* Prev / dots / next. The pills name the examples; these give position and a
     "there is more" affordance at the bottom of a long card, where the pills are
     already off screen. */
  .ctrls { display: flex; align-items: center; justify-content: center; gap: var(--caail-space-4); margin: var(--caail-space-5) 0 0; }
  .arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; padding: 0; cursor: pointer;
    color: var(--caail-muted); background: var(--caail-bg);
    border: 1px solid var(--caail-border); border-radius: 999px;
    transition: color .15s ease-out, border-color .15s ease-out;
  }
  .arrow [data-icon] { width: 1.05rem; height: 1.05rem; }
  .arrow:hover { color: var(--caail-ink); border-color: var(--caail-link); }
  .dots { display: flex; align-items: center; gap: .4rem; }
  .dot {
    width: .5rem; height: .5rem; padding: 0; cursor: pointer;
    border: 0; border-radius: 999px; background: var(--caail-border);
    transition: width .2s ease-out, background .2s ease-out;
  }
  .dot:hover { background: var(--caail-muted); }
  .dot[aria-current='true'] { width: 1.1rem; background: var(--caail-link); }

  @media (prefers-reduced-motion: reduce) {
    .card.is-enter > * { animation: none; }
    .prog.run { animation: none; }
    .dot { transition: none; }
  }

  .plabel {
    display: flex; align-items: center; gap: .45rem;
    font-size: var(--caail-fs-xs); letter-spacing: .12em; text-transform: uppercase;
    font-weight: 700; color: var(--caail-link); margin: 0 0 var(--caail-space-3);
  }
  .plabel [data-icon] { width: 1.1rem; height: 1.1rem; }

  .q { font-size: var(--caail-fs-lg); font-weight: 600; color: var(--caail-ink); margin: 0; line-height: 1.45; text-wrap: pretty; }
  .q::before { content: '“'; }
  .q::after { content: '”'; }

  .csrc code {
    font-size: var(--caail-fs-xs); color: var(--caail-link);
    background: color-mix(in oklab, var(--caail-link) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--caail-link) 22%, transparent);
    padding: .15rem .5rem; border-radius: 6px;
  }

  .head { font-size: var(--caail-fs-base); font-weight: 700; color: var(--caail-link); margin: 0 0 var(--caail-space-4); text-wrap: pretty; }

  .rows { list-style: none; margin: 0 0 var(--caail-space-4); padding: 0; display: grid; gap: var(--caail-space-2); }
  .rows li { display: grid; grid-template-columns: minmax(0, 11rem) 1fr; gap: .35rem var(--caail-space-5); align-items: baseline; margin: 0; }
  @media (max-width: 42rem) { .rows li { grid-template-columns: 1fr; } }
  /* A leading dot, drawn rather than a list-marker, so it takes the accent colour and
     sits on the text baseline at any size. */
  .rows strong { position: relative; padding-left: 1rem; font-size: var(--caail-fs-sm); font-weight: 600; color: var(--caail-ink); }
  .rows strong::before {
    content: ''; position: absolute; left: .15rem; top: .5em;
    width: 5px; height: 5px; border-radius: 50%; background: var(--caail-link);
  }
  .rows span { font-size: var(--caail-fs-sm); color: var(--caail-muted); }

  .tail { font-size: var(--caail-fs-sm); color: var(--caail-muted); margin: 0; line-height: 1.6; max-width: 82ch; text-wrap: pretty; }

  .foot { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--caail-space-2) var(--caail-space-5); margin: var(--caail-space-5) 0 0; }
  .more {
    font-size: var(--caail-fs-sm); font-weight: 600; color: var(--caail-ink);
    border: 1px solid var(--caail-border); border-radius: 999px;
    padding: .5rem 1.1rem; text-decoration: none;
    transition: border-color .15s ease-out, color .15s ease-out;
  }
  .more:hover { border-color: var(--caail-link); color: var(--caail-link); }
  .dated { display: inline-flex; align-items: center; gap: .5rem; font-size: var(--caail-fs-xs); color: var(--caail-muted); }
  /* Deliberately quiet. This is a scope qualifier, not a badge of honour or of shame —
     loud enough that nobody quotes a cell as settled, soft enough that it does not read
     as an apology for the whole library. */
  .beta {
    font-size: var(--caail-fs-xs); font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--caail-link);
    border: 1px solid color-mix(in oklab, var(--caail-link) 35%, transparent);
    background: color-mix(in oklab, var(--caail-link) 8%, transparent);
    border-radius: 999px; padding: .1rem .45rem;
  }

  @media (prefers-reduced-motion: reduce) { .pill, .arrow, .more { transition: none; } }
</style>
