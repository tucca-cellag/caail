---
/**
 * TuccaLockup — the official Tufts · Center for Cellular Agriculture horizontal
 * lockup, linking to the TUCCA site. Used in the hero and footer to attribute
 * CAAIL as a project of TUCCA.
 *
 * Theme-aware: a single PNG can't be recoloured by CSS (the Tufts blue + black
 * aren't a clean invert), so we ship BOTH official assets and swap on Starlight's
 * `html[data-theme='dark']` — black+blue in light, the white lockup in dark.
 *
 * Implemented as ONE element with a swapped `background-image` (rather than two
 * stacked <img>): a single fixed-size box is pixel-identical in both themes (no
 * cross-axis shift between the two assets), reserves its space so there's no
 * layout shift, and the browser only downloads the active theme's image. The
 * link carries the accessible name; the mark is decorative.
 *
 * The props are documented on `interface Props` below rather than restated here. This
 * block used to carry its own list, and `textName` was added to the interface without
 * it — a hand-typed inventory drifting from the authoritative one, which is the defect
 * class this component's own `NAME` constant exists to avoid.
 */
import blkbl from '../assets/tucca/cca-horiz-blkbl.png';
import white from '../assets/tucca/cca-horiz-white.png';

/**
 * The accessible name, in ONE place.
 *
 * It is needed twice — as the link's `aria-label`, and (opt-in) as text so the mark
 * is not invisible to `textContent` and select-and-copy, since the lockup is a
 * background image and the anchor otherwise contributes only whitespace. Typing it
 * in the caller was the first attempt and produced two copies that nothing pinned
 * together: rename or shorten one and sighted, AT and copied text disagree silently.
 */
const NAME = 'Tufts University Center for Cellular Agriculture';

interface Props {
  width?: number;
  class?: string;
  /**
   * Emit the name as visually-hidden, `aria-hidden` text immediately AFTER the
   * link — outside the anchor, not inside it. That placement is load-bearing
   * rather than incidental: inside the anchor it would compete with the
   * `aria-label` for the link's accessible name, and being outside is exactly
   * why `aria-hidden` on its own is sufficient here.
   *
   * Opt-in rather than always-on: it only matters where the lockup sits inside a
   * sentence (the hero attribution), and turning it on globally would change what
   * every other placement extracts to. `aria-hidden` because the anchor's
   * `aria-label` already gives assistive tech the name; this is for copied text.
   */
  textName?: boolean;
}

const { width = 168, class: className, textName = false } = Astro.props;
const height = Math.round((width * blkbl.height) / blkbl.width);
const style = `--tl-w:${width}px;--tl-h:${height}px;--tl-light:url("${blkbl.src}");--tl-dark:url("${white.src}")`;
---

<!-- The mark is deliberately tight against both tags below, and that is NOT stray
     formatting to tidy up. Astro preserves whitespace inside an element, so putting
     `.tl-mark` on its own indented line emits two text nodes inside the anchor. They
     are invisible in layout (`.tl` sets `line-height: 0`) but they are real to
     `textContent`: with `textName` on, the hero attribution extracted as
     "A project of___Tufts…" — three spaces — in the copy-and-paste surface this prop
     exists to fix. Measured on the built page rather than reasoned about. Keep the
     tags closed up; `cite.spec.ts` asserts the sentence contains no double space. -->
<a
  class:list={['tl', className]}
  href="https://cellularagriculture.tufts.edu/"
  aria-label={NAME}
  style={style}
><span class="tl-mark" aria-hidden="true"></span></a>{textName && <span class="tl-name" aria-hidden="true">{NAME}</span>}

<style>
  .tl {
    display: inline-block;
    line-height: 0;
    border-radius: 4px;
  }
  /* Present in the DOM for text extraction, absent from layout and from the
     accessibility tree (the anchor's aria-label already names this). */
  .tl-name {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .tl-mark {
    display: block;
    width: var(--tl-w);
    height: var(--tl-h);
    background: var(--tl-light) no-repeat center / contain;
  }
  /* Swap to the white lockup under Starlight's dark theme. Only the matched
     rule's image is fetched, so each theme loads just one asset. */
  :global([data-theme='dark']) .tl-mark {
    background-image: var(--tl-dark);
  }
  .tl:focus-visible {
    outline: 2px solid var(--caail-link);
    outline-offset: 3px;
  }
</style>
