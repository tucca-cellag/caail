---
import Default from '@astrojs/starlight/components/Footer.astro';
import NavCollapse from './NavCollapse.astro';
import DataTableViews from './DataTableViews.astro';
import Analytics from './Analytics.astro';
import TuccaLockup from './TuccaLockup.astro';
import CaailChatWidget from './CaailChatWidget';
import { CHAT_ENABLED } from '../lib/chat-config';
import { IDLE_TIMEOUT_MS } from '../lib/idle-timeout';
import { COMMUNITY_PATH } from '../lib/community';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="caail-footer">
  <span class="caail-foot-brand"><TuccaLockup width={150} /></span>
  <span><a href={`${base}/cite/`}>Cite</a> · <a href={`${base}${COMMUNITY_PATH}`}>Community</a> · <a href={`${base}/privacy/`}>Privacy</a> · Content licensed MIT · <a href="https://github.com/tucca-cellag/caail">canonical source on GitHub</a> · <a href="https://github.com/tucca-cellag/caail/issues" rel="noopener">Get help</a></span>
</div>
<p class="caail-foot-disclaimer">
  Linked external resources are independent of TUCCA and Tufts University and
  remain under their own licenses.
</p>
<Default><slot /></Default>
<NavCollapse />
<DataTableViews />
<Analytics />
{/* No endpoint, no widget: without one the box cannot answer, so it is not mounted (src/lib/chat-config.ts).
    It hydrates when the page is idle, or after IDLE_TIMEOUT_MS if it never is (src/lib/idle-timeout.ts). */}
{CHAT_ENABLED && <CaailChatWidget client:idle={{ timeout: IDLE_TIMEOUT_MS }} />}
<style>
  .caail-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; font-size: .72rem; color: var(--caail-muted); border-top: 1px solid var(--caail-border); padding-top: .8rem; margin-top: 1rem; }
  .caail-foot-brand { display: inline-flex; align-items: center; }
  .caail-footer a { color: var(--caail-link); }
  .caail-foot-disclaimer { margin: .5rem 0 0; font-size: .68rem; line-height: 1.4; color: var(--caail-muted); }
</style>
