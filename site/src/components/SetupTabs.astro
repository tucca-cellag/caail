---
/**
 * SetupTabs — the four install paths, extracted so the hero and the standalone
 * "Connect your agent" band can both render them.
 *
 * `compact` trims the chrome for hero use: no per-step numbering column and tighter
 * spacing. NOT a smaller reserve, which this said until the `.setup--compact` override
 * was deleted; the two variants share one reserve, for the reason given on `.panels`.
 * The content and the tab contract are identical either way, so there is one definition
 * of what the install paths ARE.
 *
 * ORDER IS AN EDITORIAL CLAIM, not arrival order. Claude Science leads because CAAIL's
 * readers are cell-ag researchers rather than engineers. `any` is deliberately LAST
 * despite being the lowest-barrier path: it is the fallback for a reader who matched
 * none of the three named clients, and putting a "nothing persists" option first
 * answers a question nobody asked yet.
 *
 * Endpoints are GitHub URLs, not this site's. Code execution defaults to network egress
 * for package managers only, which covers GitHub but not GitHub Pages, and on Team and
 * Enterprise plans only an organisation owner can widen it. Fetching from GitHub needs
 * nobody to change a setting.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  compact?: boolean;
  /** Distinguishes the two instances' element ids when both are on one page. */
  idPrefix?: string;
}
const { compact = false, idPrefix = 'gs' } = Astro.props;

const RAW = 'https://raw.githubusercontent.com/tucca-cellag/caail/main';
const PROMPT = `Read ${RAW}/plugin/skills/caail/SKILL.md and use CAAIL to answer questions about cellular agriculture and AI.`;

/* The install guide, named by its short site URL with the raw GitHub path as a fallback.
   Two URLs rather than one because they fail in opposite situations: some agents cannot
   reach GitHub Pages, and some restrict network access to package managers, a list that
   includes github.com but not github.io. Naming both means the prompt works either way
   without the reader having to diagnose which restriction they are behind.
   `setup.md` is generated from `skills/caail-install/SKILL.md`, so the two are the same
   document and cannot drift. */
const INSTALL_DOC = 'https://tucca-cellag.github.io/caail/setup.md';
const INSTALL_RAW = `${RAW}/skills/caail-install/SKILL.md`;

const paths = [
  {
    id: 'science',
    tab: 'Claude Science',
    icon: 'lucide:flask-conical',
    /* First for an audience reason and a capability reason. CAAIL's readers are
       researchers, and this is the only client that both installs the skills properly
       AND already reaches the databases the library indexes: its Featured connectors
       cover GEO, PRIDE, ArrayExpress, UniProt, Ensembl, PDB, AlphaFold and ChEMBL. No
       other path closes that loop.

       It resolves through `.claude-plugin/marketplace.json`, so it takes exactly the two
       public skills and skips both the maintainer-only `.claude/skills/` and the root
       `skills/caail-install/`. Record that as a CONDITION rather than a property of this
       repo: the same dialog also advertises a bare "any repo with skills/ directories"
       scan, and if the marketplace file ever stops resolving, that scan is what runs
       instead and the maintainer skills come with it.

       The condition is checkable at a glance rather than by inference, which is the part
       worth knowing. The Preview panel names the path it took, printing "marketplace
       manifest" beside the publisher name and the commit it would pin. If that ever reads
       otherwise, the skip is not happening. Verified 2026-09-01, Claude Science 0.1.43.

       STEPS ARE NAVIGATE, PASTE, CONFIRM, and the order is not cosmetic. The claude.ai
       path below runs the other way round, value first and destination second, because
       you cannot upload a file you have not downloaded. Here there is nothing to fetch:
       you open a dialog and type into it. Leading with the repo name hands the reader a
       string with nowhere to put it. */
    lead: 'No download, no command line. In Claude Science:',
    steps: [
      { t: 'Settings → Skills → Add skill → Import from GitHub' },
      { t: 'tucca-cellag/caail', copy: true },
      { t: 'Preview → Import 2 skills' },
    ],
    clients: [{ n: 'Claude Science', i: 'simple-icons:claude' }],
    /* Both caveats are load-bearing and neither is obvious from the dialog. The plan and
       OS gate is narrower than any other path here, and on Team and Enterprise an admin
       can disable custom skills outright. The pin is the opposite of how every other
       path behaves: those track the branch, this freezes at the commit you import, which
       matters because the skill restates corpus counts that move. */
    note: 'Beta, macOS or Linux, Pro plan or above. Both skills install, pinned to that commit; Check for updates moves them forward.',
    link: { href: 'https://claude.com/docs/claude-science/connectors-and-skills', text: 'Claude Science skills docs →' },
  },
  {
    id: 'cli',
    tab: 'Claude Code, Cursor, CLI',
    icon: 'lucide:terminal',
    /* A prompt, not the two `claude plugin` commands.
       Those commands are correct — but ONLY in Claude Code. This tab names Cursor and
       "CLI" too, and neither implements Claude Code's plugin marketplace, so the panel
       was promising three clients and serving one. The prompt points at an install skill
       that detects the client and takes the right path for each, which is the actual
       difference; for Claude Code specifically it still ends up running those two
       commands, and the note names them for anyone who would rather run them directly. */
    lead: 'Already in a coding agent? Paste this prompt. It reads the guide and installs itself:',
    steps: [{ t: `Read ${INSTALL_DOC} (if 403, use ${INSTALL_RAW}) and install CAAIL for me.`, copy: true }],
    clients: [
      { n: 'Claude Code', i: 'simple-icons:claude' },
      { n: 'Cursor', i: 'simple-icons:cursor' },
      { n: 'Windsurf', i: 'lucide:wind' },
      { n: 'Cline', i: 'lucide:terminal' },
    ],
    /* No token count here on purpose. The figure it used to quote was hand-written beside
       a file that changes, so it was wrong the moment the skill was edited and nothing
       would have said so. Describe the cost instead of measuring it in prose. */
    note: 'In Claude Code this runs claude plugin marketplace add tucca-cellag/caail then claude plugin install caail@caail. Persists across sessions, and adds one short skill to the context of every session.',
    link: { href: 'https://github.com/tucca-cellag/caail/tree/main/plugin', text: 'Read the plugin source →' },
  },
  {
    id: 'web',
    tab: 'claude.ai',
    icon: 'lucide:app-window',
    lead: 'The web app installs skills by file upload rather than by URL, so download it first:',
    steps: [
      { t: `${RAW}/plugin/skills/caail/SKILL.md`, copy: true },
      { t: 'Settings → Customize → Skills → Add → Upload skill' },
    ],
    clients: [
      { n: 'claude.ai', i: 'simple-icons:anthropic' },
      { n: 'Claude desktop', i: 'simple-icons:claude' },
    ],
    note: 'Persists across chats. Nothing to host or authenticate.',
    link: null,
  },
  {
    id: 'any',
    tab: 'Any agent',
    icon: 'lucide:message-square',
    lead: 'To use CAAIL, copy this prompt and send it to your AI agent:',
    steps: [{ t: PROMPT, copy: true }],
    clients: [
      { n: 'Claude', i: 'simple-icons:anthropic' },
      { n: 'ChatGPT', i: 'simple-icons:openai' },
      { n: 'Gemini', i: 'simple-icons:googlegemini' },
      { n: 'Cursor', i: 'simple-icons:cursor' },
      { n: 'Copilot', i: 'simple-icons:githubcopilot' },
    ],
    note: 'Loads for this conversation only; nothing is installed.',
    link: null,
  },
];---

<div class:list={['setup', compact && 'setup--compact']}>
  <div class="tabs" role="tablist" aria-label="Setup paths">
    {paths.map((p, i) => (
      <button
        type="button" role="tab" id={`${idPrefix}-t-${p.id}`} class="tab"
        aria-controls={`${idPrefix}-p-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      ><Icon name={p.icon} />{p.tab}</button>
    ))}
  </div>

  <div class="panels">
    {paths.map((p, i) => (
      <div role="tabpanel" id={`${idPrefix}-p-${p.id}`} aria-labelledby={`${idPrefix}-t-${p.id}`} class="panel" hidden={i !== 0}>
        <p class="lead">{p.lead}</p>

        {/* A step is either a VALUE you paste or an ACTION you take, and only the first
            gets a copy button. Every step used to get one, because when this was written
            every step happened to be a command. It stopped being true as soon as a path
            needed "go to this menu": a copy affordance on a navigation path invites you
            to paste a menu trail somewhere, and it buries the one line that IS meant to
            be copied among identical-looking rows. */}
        {p.steps.map((s, n) => (
          <div class:list={['cmd', !s.copy && 'cmd--do']}>
            {p.steps.length > 1 && <span class="n">{n + 1}</span>}
            {s.copy ? <code>{s.t}</code> : <span class="do">{s.t}</span>}
            {s.copy && (
              <button type="button" class="copy" data-copy={s.t} aria-label={`Copy: ${s.t}`}>
                <Icon name="lucide:copy" class="i-copy" />
                <Icon name="lucide:check" class="i-done" />
              </button>
            )}
          </div>
        ))}

        <p class="note">
          <span class="clients">
            {p.clients.map((c) => (
              <span class="client"><Icon name={c.i} />{c.n}</span>
            ))}
          </span>
          {p.note}
          {p.link && <a href={p.link.href}>{p.link.text}</a>}
        </p>
      </div>
    ))}
  </div>

  {/* Says plainly what is built and what is not, and the list shrank on 2026-09-01.
      Claude Science left it because its GitHub import installs both skills for real,
      which had turned this line into an UNDERclaim: the same defect as an overclaim, in
      the other direction, and harder to notice because nobody complains about a product
      being undersold. What genuinely does not exist yet is a ChatGPT app or a Gemini
      extension.

      Removing a name from the list also moves the COUNT, so "all three" became "both".
      Those two edits are one edit; changing the list alone leaves a sentence that
      contradicts itself and still reads fine. */}
  <p class="soon">
    <Icon name="lucide:clock" />
    <span>Dedicated <strong>ChatGPT</strong> and <strong>Gemini</strong> integrations are in progress. Until then the <strong>Any agent</strong> prompt works in both; it just does not persist.</span>
  </p>

  <output class="visually-hidden" aria-live="polite"></output>
</div>

<script>
  // Astro hoists and dedupes this, so it runs once no matter how many instances of
  // the component are on the page; the selectors cover every instance.
  import { initTabs, initCopyButtons } from '../lib/tabs';
  initTabs('.setup .tabs');
  initCopyButtons('.setup');
</script>

<style>
  /* Underline rail: the tabs sit ON the rule, so the active one reads as a continuation
     of the panel below rather than a detached chip. -1px pulls each tab's own 2px border
     over the 1px rule so they occupy the same line. */
  .tabs { display: flex; flex-wrap: wrap; gap: var(--caail-space-5); border-bottom: 1px solid var(--caail-border); margin: 0 0 var(--caail-space-5); }
  .setup--compact .tabs { gap: var(--caail-space-4); margin-bottom: var(--caail-space-4); }
  .tab {
    display: inline-flex; align-items: center; gap: .4rem;
    font: inherit; font-size: var(--caail-fs-sm); font-weight: 600;
    color: var(--caail-muted); background: none; border: 0;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
    padding: 0 0 var(--caail-space-3); cursor: pointer;
    transition: color .15s ease-out, border-color .15s ease-out;
  }
  .tab [data-icon] { width: 1rem; height: 1rem; }
  .tab:hover { color: var(--caail-ink); }
  .tab[aria-selected='true'] { color: var(--caail-primary); border-bottom-color: var(--caail-primary); }

  /* Reserve the tallest panel's height so switching tabs does not shift the page under
     the pointer. The reserve has to clear the TALLEST panel, not a typical one: anything
     shorter merely floors the shortest panel and lets the rest overflow it, which is a
     jump wearing the costume of a reserve.

     Measured 2026-09-01 with `.panels { min-height: 0 }` forced, sweeping 545-1600px.
     Each figure is that panel's MAXIMUM over the range, with the widths it occurs at.
     Carrying the coordinate is the whole point: an earlier version of this comment gave
     three numbers with no widths attached, all of them sampled at 600px, and the reserve
     derived from them was 16px short at 545-560px. That shortfall was live, and nothing
     in the suite noticed, because the suite sampled 600px too.

       science  240 flat        cli  236 @545-560
       web      207 @545-560    any  158 @<=740

     ONE BAND, not two. There was a second reserve below 48rem because the cli panel
     outgrew everything else down there as its note wraps. It still does, reaching 236,
     but the Claude Science panel is 240 and flat, so it is the tallest at every width and
     one number covers the range. Do not reintroduce a band without re-running the sweep:
     two numbers where one will do is two things to get wrong.

     Below 34rem the panels wrap to unpredictable heights and a fixed reserve would strand
     a large gap, so it lifts entirely.

     Compact and full share one reserve because they measure the same: the variant changes
     the chrome around the panels, not the panels. Confirmed by sweeping both roots. The
     old `.setup--compact` override was a second number for identical content, and at 9rem
     (144px) it cleared only the first panel, so every hero tab click resized the hero by
     up to 37px and re-ran the stripe ResizeObserver that Hero.astro is written not to
     provoke.

     `homepage-agent.spec.ts` asserts constant section height across tabs for BOTH
     instances at three widths, so a panel that outgrows this fails the suite instead of
     shipping. */
  .panels { min-height: 15.25rem; }  /* 244px, clears the 240px tallest at every width */
  @media (max-width: 34rem) { .panels { min-height: 0; } }

  /* A plain sentence, matching the reference. The icon moved onto the tab, where it
     labels the path itself rather than decorating the instruction. */
  .lead { font-size: var(--caail-fs-sm); color: var(--caail-muted); margin: 0 0 var(--caail-space-3); line-height: 1.5; }

  /* Command row: a tinted well rather than a left rule. A 2px coloured side-stripe is a
     borrowed shape, and a full container reads as a thing you copy from. */
  /* Flex, NOT a three-track grid.
     `grid-template-columns: auto 1fr auto` assumed three children, but the step number
     is only rendered when a path has more than one step. On the single-step panel the
     code landed in track 1 (auto, so it took 1033px) and the copy button was squeezed
     into `1fr` with nothing left — it computed to 10px wide with 0px icons, which read
     on the page as "the prompt has no copy button at all".
     Flex has no fixed track count, so a conditional child cannot shift anything. */
  .cmd {
    display: flex; align-items: flex-start; gap: .5rem;
    background: color-mix(in oklab, var(--caail-link) 5%, transparent);
    border: 1px solid var(--caail-border); border-radius: 8px;
    padding: .55rem .6rem; margin: 0 0 var(--caail-space-2);
  }
  /* An ACTION row is not a field: no tint, no border, no padding. Those are the visual
     grammar of "there is something here to take", and a menu trail has nothing to take.
     Dropping the box also buys back the row's vertical padding, which is why adding a
     third step to the Claude Science path cost less height than the second one did. */
  .cmd--do { background: none; border-color: transparent; padding-left: 0; padding-right: 0; }
  .cmd .do { flex: 1 1 auto; min-width: 0; font-size: var(--caail-fs-xs); line-height: 1.6; color: var(--caail-muted); overflow-wrap: anywhere; }

  /* Same line-height as the code it numbers, so the digit sits on the code's first
     baseline rather than a few pixels above it. */
  .cmd .n { flex: none; font-size: var(--caail-fs-xs); font-weight: 600; color: var(--caail-muted); line-height: 1.6; min-width: .75rem; }
  .cmd code { flex: 1 1 auto; min-width: 0; font-size: var(--caail-fs-xs); line-height: 1.6; color: var(--caail-ink); background: none; padding: 0; overflow-wrap: anywhere; }

  .copy { display: inline-flex; flex: none; padding: .3rem; border-radius: 8px; border: 0; background: none; color: var(--caail-muted); cursor: pointer; transition: color .15s ease-out, background .15s ease-out; }
  .copy:hover, .copy:focus-visible { color: var(--caail-primary); background: color-mix(in oklab, var(--caail-link) 12%, transparent); }
  .copy [data-icon] { width: 1rem; height: 1rem; }
  /* Swap the glyph on success. The aria-live output carries the same news for anyone
     who cannot see a glyph change, so this is not the only signal. */
  .copy .i-done { display: none; }
  .copy.is-done { color: var(--caail-link); }
  .copy.is-done .i-copy { display: none; }
  .copy.is-done .i-done { display: inline-block; }

  .note { font-size: var(--caail-fs-xs); color: var(--caail-muted); margin: var(--caail-space-3) 0 0; line-height: 1.55; max-width: var(--caail-measure); }
  .note a { margin-left: .35rem; white-space: nowrap; }
  /* Names the agents the step actually works in, so the reader can check themselves
     off the list before copying anything. */
  /* Names AND marks the agents the step works in. Brand logos are used nominatively —
     to identify a compatible client — which is what a compatibility list is for. */
  .clients { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .7rem; margin: 0 0 .3rem; }
  .client { display: inline-flex; align-items: center; gap: .3rem; color: var(--caail-ink); font-weight: 600; }
  .client [data-icon] { width: .85rem; height: .85rem; opacity: .75; }

  .soon {
    display: flex; align-items: flex-start; gap: .45rem;
    font-size: var(--caail-fs-xs); color: var(--caail-muted);
    margin: var(--caail-space-4) 0 0; padding-top: var(--caail-space-3);
    border-top: 1px dashed var(--caail-border);
    line-height: 1.55;
  }
  .soon [data-icon] { width: .95rem; height: .95rem; flex: none; margin-top: .1rem; }
  .soon strong { color: var(--caail-ink); font-weight: 600; }
  /* One notice per page, not one per instance: the hero and the standalone band render
     the same component, and the same "coming soon" line twice reads as a bug. */
  .setup--compact .soon { display: none; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) {
    .tab, .copy { transition: none; }
  }
</style>
