---
/**
 * RevealScript — arms the `.sr` scroll-reveal system (see styles/reveal.css).
 *
 * Two scripts, and the split is the point.
 *
 * The first is `is:inline` so it is not bundled, deferred or module-scoped: it runs
 * synchronously at the position it appears in the document. Placed above the revealed
 * sections, it sets `sr-ready` before those elements are parsed, so they are never
 * painted visible and then yanked hidden. Inlining it also means it cannot be delayed
 * behind a module graph, which is the window a flash would live in.
 *
 * It arms the offset state ONLY if IntersectionObserver exists to later remove it.
 * Setting the class first and feature-detecting afterwards would leave a browser
 * without the observer stuck on a permanently offset page.
 *
 * There is no eager-reveal window and no no-scroll timeout any more. Both existed to
 * stop captures rendering blank, and both became unnecessary — and actively harmful —
 * once the reveal went transform-only: an unrevealed element is now fully visible and
 * merely 20px low, so nothing needs rescuing, while the timeout was silently revealing
 * the whole page for anyone who paused on the hero for 2.5s before scrolling, which is
 * most readers. They then scrolled through a page where nothing animated.
 *
 * The second is an ordinary bundled module that does the observing. If it never runs,
 * `sr-ready` is set but nothing is hidden yet either, because CSS only hides elements
 * carrying `.sr`, and the worst case is a page that renders exactly as it does today
 * with motion turned off.
 */
---

<script is:inline>
  if ('IntersectionObserver' in window) {
    document.documentElement.classList.add('sr-ready');
  }
</script>

<script>
  // Reveal once and stop watching. Re-hiding on scroll-up means a reader who scrolls
  // back to re-read a paragraph watches it fade out from under them.
  const targets = document.querySelectorAll<HTMLElement>('.sr');
  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('in');
          obs.unobserve(e.target);
        }
      },
      // The top margin is enormous ON PURPOSE, and it is the whole correctness argument.
      //
      // IntersectionObserver reports a CHANGE in intersection, not a state. With a plain
      // `0px 0px -12% 0px` an instant scroll — a TOC click, a scrollbar drag, End, or
      // landing on a #hash — moves an element from below the viewport to above it between
      // two samples. Old state: not intersecting. New state: not intersecting. No callback
      // is ever delivered, the element keeps its offset forever, and because reveal is the
      // only thing that unobserves, nothing later rescues it. Measured on this page: one
      // jump to the bottom left 21 of 26 elements permanently 34px low, which reads as
      // overlapping text and as "the animation doesn't work". Adding the HomeRail made it
      // routine, since every rail click is exactly that jump.
      //
      // Extending the root 10^6px upward makes "above the viewport" a permanently
      // intersecting region, so the only transition that exists is below → intersecting.
      // An element can be scrolled past arbitrarily fast and still lands inside it.
      //
      // The -12% bottom is unchanged and still does the real work: fire just before the
      // top edge clears the viewport bottom, so the lift finishes about when the reader's
      // eye arrives rather than starting there.
      { rootMargin: '1000000px 0px -12% 0px', threshold: 0 },
    );
    for (const t of targets) io.observe(t);

    // Print is the one case worth forcing: a print job never scrolls, and a 20px offset
    // repeated down a page reads as sloppy typesetting rather than as motion.
    window.addEventListener('beforeprint', () => {
      for (const t of targets) {
        t.classList.add('in');
        io.unobserve(t);
      }
    });
  }
</script>
