---
import { Icon } from 'astro-icon/components';
import HeroGraphic from './HeroGraphic.astro';
import TuccaLockup from './TuccaLockup.astro';
import SetupTabs from './SetupTabs.astro';
import c from '../content/data/counts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * The hero counter rotates rather than listing all five at once.
 *
 * The five-up static row it replaces was the "big number, small label, supporting
 * stats" hero-metric template, and at five columns it was also the densest thing in a
 * hero the page had already been criticised for over-packing. One number at a time
 * says the same thing with a quarter of the ink, and the rotation is what makes the
 * breadth legible: you watch the library turn out to be four different collections.
 *
 * Every entry is rendered into the DOM and stacked in one grid cell, so the box is
 * sized by the widest entry and never reflows mid-rotation. That is not only a
 * jitter fix — Hero pins the diagonal stripe to the title's rect via a ResizeObserver
 * on `.hero`, so a counter that changed width would re-run that measurement on a
 * three-second loop forever.
 */
const stats = [
  { n: c.papers, label: 'papers', href: '/papers/explorer/' },
  { n: c.software, label: 'software tools', href: '/software/' },
  { n: c.databases, label: 'databases', href: '/databases/' },
  { n: c.datasets, label: 'datasets', href: '/datasets/' },
];

/** Spoken once, in full, instead of announcing each rotation. */
const statSentence = `Indexing ${stats.map((s) => `${s.n} ${s.label}`).join(', ')}.`;
---
<section class="hero" id="top">
  <div class="hero-stripe" aria-hidden="true"></div>
  <div class="hero-text">
    {/* Spells out the acronym. The nav title is a bare "CAAIL" and the h1 is the stylised
        wordmark, so without this line a first-time reader never learns what it stands for.

        The expansion is a hand-typed copy of CITATION.cff's title, which is the defect class
        CLAUDE.md calls this repo's most expensive. It is checked rather than asserted:
        `src/lib/project-name.test.ts` fails if the two drift. Do not replace that with a
        comment promising they match — that is the thing the rule forbids. */}
    <p class="eyebrow">CAAIL · Cellular Agriculture AI Library</p>
    <h1 class="h-title caail-display">
      <span class="l1">Cell&nbsp;Ag</span>
      <span class="l2"><span class="x">×</span> AI</span>
    </h1>

    <p class="lede">
      The curated library at the intersection of cellular agriculture and AI, and a grounding
      database an AI assistant can query, so research and industry questions can be answered
      from a fixed, citable index rather than from model memory.
    </p>

    <div class="cta-row">
      <a class="btn btn-primary" href={`${base}/papers/explorer/`}>
        <Icon name="lucide:layout-grid" />
        Open the Papers Explorer
      </a>
      <a class="btn btn-ghost" href="https://github.com/tucca-cellag/caail">
        <Icon name="lucide:github" />
        Browse on GitHub
      </a>
    </div>

    <div class="ticker">
      <div class="tick-col">
        {/* Hidden from AT: a value retyped character by character is noise to a screen
            reader, and the same facts are stated once, in full, in the sentence below.
            Server-rendered complete, so with no JS this is simply the first statistic. */}
        <p class="tick" aria-hidden="true" data-stats={JSON.stringify(stats.map((s) => [String(s.n), s.label]))}>
          <span class="tick-n caail-display">{stats[0].n}</span>
          <span class="tick-l">{stats[0].label}</span>
          <span class="tick-caret"></span>
        </p>
        {/* The width reserve. Every entry, rendered in the same grid cell as the live
            counter and hidden, so this column is exactly as wide as the widest entry —
            measured by the browser in whatever font is actually applied, rather than
            asserted as a number that only holds at one font size.

            That is what lets the routes beside it wrap on content instead of on a
            breakpoint. A media or container query cannot see a reader's minimum-font-size
            setting: it grows the label without growing the column, and at 20px the
            counter ran 82px into the routes at every width. Deriving the reserve removes
            the question rather than re-measuring the answer. */}
        <p class="tick-reserve" aria-hidden="true">
          {stats.map((s) => (
            <span class="tick-ghost">
              <span class="tick-n caail-display">{s.n}</span>
              <span class="tick-l">{s.label}</span>
              <span class="tick-caret"></span>
            </span>
          ))}
        </p>
        <p class="visually-hidden">{statSentence}</p>
        <a class="tick-cap" href={`${base}/by-the-numbers/`}>Counted at build time <span aria-hidden="true">→</span></a>
      </div>

      {/* The three ways in, in the space the counter leaves empty.
          Each is a route, not a benefit: what you get and where, phrased so a reader can
          check it rather than agree with it. The affordances all existed already — the
          GitHub button above, the setup tabs below — but nowhere said there were three of
          them, which is the gap this closes. */}
      {/* The icon is INSIDE the anchor, matching .cta-row and .hero-router above and below.
          As a sibling it was dead to clicks and sat outside the focus ring, so the row read
          as one target while only part of it was one.

          The label is wrapped rather than left bare because the anchor is a flex row: bare,
          the <b> and the text after it would be two flex items and the .5rem gap would open
          up mid-sentence. Two children — icon, label — keeps the text flowing inside one. */}
      <ul class="ways">
        <li>
          <a href={`${base}/papers/explorer/`}>
            <Icon name="lucide:app-window" />
            <span><b>Browse it here</b> — filter by method and area</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/tucca-cellag/caail">
            <Icon name="lucide:github" />
            <span><b>Read it on GitHub</b> — canonical Markdown</span>
          </a>
        </li>
        <li>
          <a href={`${base}/#connect`}>
            <Icon name="lucide:terminal" />
            <span><b>Query it from an agent</b> — one skill, JSON endpoints</span>
          </a>
        </li>
      </ul>
    </div>

  </div>

  <div class="hero-art">
    <HeroGraphic variant="bioreactor" />
  </div>

  <div class="hero-setup">
    <p class="hero-setup-hd">Point an AI agent at it</p>
    <SetupTabs compact idPrefix="hero" />
  </div>

  <nav class="hero-router" aria-label="Entry points">
    <a href={`${base}/primers/cell-ag/`}><Icon name="lucide:sprout" /> New to cell ag</a>
    <a href={`${base}/primers/ai/`}><Icon name="lucide:brain" /> New to AI</a>
    <a href={`${base}/papers/explorer/`}><Icon name="lucide:layout-grid" /> Browse the matrix</a>
    <a href={`${base}/community/`}><Icon name="lucide:users" /> Community</a>
    <a href={`${base}/cite/`}><Icon name="lucide:quote" /> Cite CAAIL</a>
    {/* Two spans, because the line has to carry two different claims and an earlier draft
        lost one of them. Replacing "A project of" outright with "Built and used in R&D at"
        left the homepage saying only that TUCCA *uses* CAAIL, which reads as a third-party
        tool TUCCA adopted, and ownership then survived only on /about.

        The spaces inside the spans are deliberate. Word separation here must not depend on
        `TuccaLockup`'s internal formatting: its anchor happens to emit whitespace around the
        `aria-hidden` span today, so `textContent` reads correctly without them, but that is
        incidental line-breaking in another component rather than anything this line controls.
        Reformat or minify that file differently and the words run together in select-and-copy
        and in the Pagefind index, where the `flex gap` between them does not exist.

        "TUCCA's own" rather than "its own": the nearest antecedent is a link whose visible
        content is an image, so "its" can attach to CAAIL and claim CAAIL is used in CAAIL's
        own R&D.

        Deliberately unquantified — what CAAIL adds to an agent's answers is unmeasured
        (CAAIL-168), so "we use it" is assertable and "it works better" is not.
        The row is `flex-wrap`; the wrap was checked at 390 and 1440, not assumed. */}
    <p class="hero-attrib"><span>A project of </span><TuccaLockup width={150} /><span> and used in TUCCA&rsquo;s own R&amp;D</span></p>
  </nav>
</section>

<style>
  .hero { position: relative; display: grid; grid-template-columns: 1fr; gap: 1.1rem; padding: 1.5rem 0 .75rem; text-align: left; }
  @media (min-width: 60rem) {
    /* Two columns for the editorial row only. The setup block and the router span both,
       so the prompt gets full width (it wrapped to four lines in a 27rem column) and the
       two columns are never asked to match heights they have no reason to match. */
    .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 25rem); align-items: center; gap: 1.5rem 2.5rem; }
    .hero-setup, .hero-router { grid-column: 1 / -1; }
  }
  /* hero content sits above the diagonal stripe */
  .hero-text, .hero-art, .hero-setup, .hero-router { position: relative; z-index: 1; }


  /* Full-bleed diagonal CAAIL-blue band behind the hero (trimgalore-style).
   * The wrapper breaks out to the full viewport width and self-clips, so the
   * rotated band reaches both screen edges without causing horizontal scroll.
   * (Splash homepage has no left sidebar, so the hero is viewport-centered.) */
  .hero-stripe {
    position: absolute;
    /* Starts above the hero box, not at it. The band rises to the right, so with
     * `top: 0` it was clipped at the hero's top edge and left a white wedge in
     * the top-right corner between the header and the band. -1.5rem is the
     * splash layout's content padding above the hero. The inline script derives
     * --stripe-cy from this wrapper's own rect, so the band still crosses the
     * title at the same place. */
    top: -1.5rem; bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    overflow: clip;
    z-index: 0;
    pointer-events: none;
  }
  .hero-stripe::before {
    content: "";
    position: absolute;
    /* --stripe-cy is set by the inline script to the title's vertical centre
     * (relative to this wrapper) so the band always crosses behind the title,
     * consistently, at every width. Falls back to the hero's centre. */
    top: var(--stripe-cy, 50%); left: -5%;
    width: 110%;
    height: clamp(72px, 9vw, 150px);
    transform: translateY(-50%) rotate(-11deg);
    /* Stops come from tokens.css and are sRGB on purpose: an oklch/oklab-stopped
     * gradient interpolates in oklab, which Firefox does per-pixel on the CPU.
     * Repainting this rotated full-bleed stripe every scroll frame then janked
     * the homepage in Firefox only (Chromium caches the rasterization). See the
     * note on --caail-hero-stripe-from in tokens.css before changing these. */
    background: linear-gradient(90deg,
      var(--caail-hero-stripe-from),
      var(--caail-hero-stripe-to));
    border-radius: 4px;
  }

  .eyebrow { font-size: var(--caail-fs-xs); letter-spacing: .14em; text-transform: uppercase; color: var(--caail-accent); font-weight: 700; margin: 0; }
  .h-title {
    font-size: clamp(2.9rem, 7vw, 4.6rem);
    line-height: 0.92;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: .4rem 0 .7rem;
    background: linear-gradient(118deg, var(--caail-primary) 12%, var(--caail-link) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--caail-primary);
  }
  .h-title .l1, .h-title .l2 { display: block; }
  @supports (-webkit-background-clip: text) or (background-clip: text) {
    .h-title { -webkit-text-fill-color: transparent; }
  }
  .h-title .x { color: var(--caail-accent); -webkit-text-fill-color: var(--caail-accent); font-weight: 600; }

  .lede { font-size: 1rem; line-height: 1.6; color: var(--caail-muted); max-width: 52ch; margin: 0 0 1.1rem; }

  .cta-row { display: flex; gap: .7rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .btn { display: inline-flex; align-items: center; gap: .5rem; border-radius: 999px; padding: .8rem 1.5rem; font-size: var(--caail-fs-lg); font-weight: 600; text-decoration: none; border: 1.5px solid transparent; transition: background .15s, border-color .15s, color .15s, box-shadow .15s; }
  .btn [data-icon] { width: 1.15rem; height: 1.15rem; }
  .btn-primary { background: var(--caail-primary); color: #fff; box-shadow: 0 10px 26px -16px color-mix(in oklab, var(--caail-primary) 70%, transparent); }
  .btn-primary:hover { background: var(--caail-primary-hover); }
  .btn-ghost { background: var(--caail-bg); color: var(--caail-ink); border-color: var(--caail-border); }
  .btn-ghost:hover { border-color: var(--caail-link); color: var(--caail-link); }

  /* Rotating counter, replacing the five-up stat row.
   *
   * Every entry occupies the SAME grid cell (`grid-area: 1/1`), so the paragraph is as
   * wide and tall as the widest entry and never changes size as entries swap. Without
   * that the hero would reflow four times a rotation, and the ResizeObserver that pins
   * the diagonal stripe to the title would re-measure on every one of them. */
  .ticker { margin: 0; padding-top: 1.25rem; border-top: 1px solid var(--caail-border); }
  /* The line height is reserved, not derived from its contents. Mid-erase the text is
     briefly empty, and a line that collapsed to zero would change the hero's height
     four times a cycle — re-running the ResizeObserver that pins the diagonal stripe,
     on a loop, forever. Width is free to change: the paragraph is block-level, so the
     text growing and shrinking inside it never resizes anything above. */
  /* 2.75rem, not the 2.4rem of the number itself. With `align-items: baseline` the flex
     line is as tall as the number's ascent plus the label's descent, which measured
     41px against a 38.4px number — so a reserve equal to the number still let the line
     collapse 3px whenever the text emptied mid-erase. Three pixels, four times a cycle,
     forever, each one re-running the stripe ResizeObserver. */
  /* `nowrap` guards the same height from the other direction. The reserve is a FLOOR, not
     a fixed height: it stops the line collapsing when the text empties mid-erase, but
     nothing stopped it growing. Once the routes sit beside it the counter's track narrows,
     and the widest entry ("139 software tools") wrapped to a second line — the same
     ResizeObserver loop the reserve exists to prevent, arriving from the opposite side.
     What `nowrap` costs is that an over-wide counter overflows silently instead of
     reflowing, which is why the routes are gated on a container query rather than a
     viewport one; see the note on that query below. */
  .tick { display: flex; align-items: baseline; gap: .5rem; margin: 0; min-height: 2.75rem; white-space: nowrap; }
  .tick-n { font-size: 2.4rem; font-weight: 700; color: var(--caail-primary); line-height: 1; letter-spacing: -.02em; }
  .tick-l { font-size: var(--caail-fs-lg); font-weight: 600; color: var(--caail-ink); }

  /* Caret. A drawn block rather than a "|" glyph, so it keeps its weight at any font
     and sits on the same baseline as the number it trails. */
  .tick-caret {
    display: inline-block; width: 2px; height: 1.6rem; margin-left: -.25rem;
    background: var(--caail-link);
    animation: tick-blink 1.06s step-end infinite;
  }
  @keyframes tick-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* Counted at build time, linking to where that can be checked. The claim and the
     evidence are the same element, which is the point: it is not an assertion about
     CAAIL being open, it is the number's provenance plus the page that shows it. */
  /* `:focus-visible` alongside `:hover` — this replaced a plain <p>, so it is new
     interactive surface, and the routes beside it already give keyboard users the same
     colour change the mouse gets. */
  .tick-cap { display: inline-block; font-size: var(--caail-fs-xs); color: var(--caail-muted); text-decoration: none; margin-top: .3rem; transition: color .15s ease-out; }
  .tick-cap:hover, .tick-cap:focus-visible { color: var(--caail-link); }
  @media (prefers-reduced-motion: reduce) { .tick-cap { transition: none; } }

  /* The three ways in. Stacked below the counter on one column; beside it above 68rem. */
  .ways { list-style: none; margin: var(--caail-space-4) 0 0; padding: 0; display: grid; gap: .35rem; }
  .ways li { font-size: var(--caail-fs-sm); }
  /* The flex row is the ANCHOR's, not the li's, so the icon is inside the target and
     inside the focus ring. Exactly two children: the icon, and the wrapped label. */
  .ways a { display: flex; align-items: baseline; gap: .5rem; color: var(--caail-muted); text-decoration: none; transition: color .15s ease-out; }
  .ways [data-icon] { width: .95rem; height: .95rem; flex: none; align-self: center; color: var(--caail-link); }
  .ways b { color: var(--caail-ink); font-weight: 600; }
  /* `b` carries its own colour, so it does not inherit the hover — without this the lead-in
     stays ink while only the trailing clause lights up, and half a link changes state.
     `.hero-router` recolours its whole label, and these two strips sit six lines apart. */
  .ways a:hover, .ways a:focus-visible { color: var(--caail-link); }
  .ways a:hover b, .ways a:focus-visible b { color: inherit; }
  @media (prefers-reduced-motion: reduce) { .ways a { transition: none; } }

  /* The routes sit beside the counter when they fit and wrap under it when they do not.
     There is NO breakpoint here, and that is deliberate.

     Every width-based gate we tried was blind to the thing that actually decides whether
     the two fit: how large the text renders. `rem` in a media query resolves against the
     browser's INITIAL font size, so raising the default font size or using Firefox's "zoom
     text only" left `68rem` meaning 1088px while every word in the row got bigger — 204px
     of overlap at 125%, 326px at 200%, at every width up to 1440. Moving to a container
     query in `em` fixed that path, and still missed a reader's minimum-font-size setting,
     which grows the label without growing the column: 82px of overlap at a 20px minimum.
     Because the counter is `nowrap` none of this reflows, so two blocks of text simply
     paint over each other with nothing to signal it.

     Flex wrapping asks the browser the question instead. `.tick-col` is sized by the
     hidden reserve above — the widest entry, measured in whatever font is applied — so it
     is both stable while the counter types AND correct at any text size. When the routes
     no longer fit beside it they move to their own line, which is what they do on one
     column anyway. Nothing to re-measure when a label grows or a route line is reworded. */
  .ticker { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--caail-space-6); row-gap: var(--caail-space-4); }
  .tick-col { flex: 0 0 auto; }
  .ways { flex: 1 1 auto; margin: 0; }

  /* The live counter and the reserve share one grid cell, so the column takes the width
     and height of the reserve and the counter is painted over it. `.tick-cap` sits on its
     own row beneath. */
  .tick-col { display: grid; grid-template-columns: max-content; }
  .tick, .tick-reserve { grid-area: 1 / 1; }
  .tick-cap { grid-row: 2; }
  .tick-reserve { display: grid; margin: 0; visibility: hidden; pointer-events: none; }
  .tick-ghost { grid-area: 1 / 1; display: flex; align-items: baseline; gap: .5rem; white-space: nowrap; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  /* Reduced motion: the script never types, so the caret would sit blinking next to a
   * statistic that is not going to change. Remove it entirely rather than leave a
   * promise the page does not keep. */
  @media (prefers-reduced-motion: reduce) {
    .tick-caret { display: none; animation: none; }
  }

  /* TUCCA attribution — sits under the stat row, left-aligned with the hero. */
  .hero-attrib { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; margin: 0 0 0 auto; }
  .hero-attrib > span { font-size: var(--caail-fs-xs); letter-spacing: .04em; text-transform: uppercase; color: var(--caail-muted); font-weight: 600; }

  /* Graphic only in the wide 2-col layout — below 60rem the hero is text-only
   * (avoids the oversized graphic stacking below the text at mid widths). */
  .hero-art { display: none; }
  /* Capped. At its natural 400px width the bioreactor stood 453px tall and became the
     tallest thing in row 1 — so it, not the text, set the row height and pushed the
     router strip out of the fold. Scaling it down costs nothing: it is decoration with
     no detail that needs the extra pixels. */
  @media (min-width: 60rem) {
    .hero-art { display: flex; justify-content: center; align-items: center; }
    .hero-art :global(svg) { max-width: 19rem; height: auto; }
  }

  /* Setup block. Full width, hairline above — the same rule that separates the counter,
     so the fold reads as stacked registers rather than unrelated widgets. No card border:
     a box here would compete with the bioreactor for attention. */
  .hero-setup { padding-top: 1.1rem; border-top: 1px solid var(--caail-border); }
  .hero-setup-hd { font-size: var(--caail-fs-sm); font-weight: 600; color: var(--caail-ink); margin: 0 0 .75rem; }

  /* Router strip: the five doors, closing the fold. Hairline above, no boxes — the icons
     and the rule carry the structure. */
  .hero-router { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem 1.5rem; padding-top: .85rem; border-top: 1px solid var(--caail-border); }
  .hero-router a { display: inline-flex; align-items: center; gap: .4rem; font-size: var(--caail-fs-sm); font-weight: 600; color: var(--caail-muted); text-decoration: none; transition: color .15s ease-out; }
  .hero-router a:hover { color: var(--caail-link); }
  .hero-router [data-icon] { width: 1.05rem; height: 1.05rem; color: var(--caail-link); }
  @media (prefers-reduced-motion: reduce) { .hero-router a { transition: none; } }
</style>

<script>
  // Pin the diagonal stripe's vertical centre to the title's centre so it
  // always crosses behind "Cell Ag × AI" at every width (the band stays
  // full-bleed horizontally via the .hero-stripe wrapper). Positioning only —
  // not animation — so reduced-motion is irrelevant.
  function positionHeroStripe() {
    const stripe = document.querySelector<HTMLElement>('.hero-stripe');
    const title = document.querySelector<HTMLElement>('.h-title');
    if (!stripe || !title) return;
    const s = stripe.getBoundingClientRect();
    const t = title.getBoundingClientRect();
    stripe.style.setProperty('--stripe-cy', `${t.top - s.top + t.height / 2}px`);
  }
  positionHeroStripe();
  const hero = document.querySelector('.hero');
  if (hero && 'ResizeObserver' in window) new ResizeObserver(positionHeroStripe).observe(hero);
  window.addEventListener('resize', positionHeroStripe);
  if (document.fonts?.ready) document.fonts.ready.then(positionHeroStripe);

  // Type the hero counter, erasing and retyping between collections.
  //
  // The markup already contains the first statistic in full, so with no JS, a script
  // error, or reduced motion, the hero shows a real number rather than an empty line.
  // The typing is the enhancement; it is never what makes the content exist.
  //
  // Number and label are two elements for typographic reasons, but one string for
  // typing purposes: a single character budget is spent across the pair, so the effect
  // reads as one continuous line rather than two fields filling independently.
  const tick = document.querySelector<HTMLElement>('.hero .tick');
  const nEl = tick?.querySelector<HTMLElement>('.tick-n');
  const lEl = tick?.querySelector<HTMLElement>('.tick-l');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (tick && nEl && lEl && !still.matches) {
    let entries: [string, string][] = [];
    try {
      entries = JSON.parse(tick.dataset.stats ?? '[]');
    } catch {
      entries = [];
    }

    if (entries.length > 1) {
      const TYPE = 55; // per character, typing
      const ERASE = 28; // faster: re-reading text you have already read is dead time
      const HOLD = 2000; // long enough to actually read the statistic
      const GAP = 320; // beat after erasing, before the next one starts

      let entry = 0;
      let chars = entries[0]![0].length + 1 + entries[0]![1].length; // fully typed
      let erasing = false;
      let timer = 0;

      /** Spend `chars` characters across the number, the space, then the label. */
      const paint = () => {
        const [n, label] = entries[entry]!;
        nEl.textContent = n.slice(0, Math.min(chars, n.length));
        const intoLabel = chars - n.length - 1;
        lEl.textContent = intoLabel > 0 ? label.slice(0, intoLabel) : '';
      };

      const step = () => {
        const [n, label] = entries[entry]!;
        const full = n.length + 1 + label.length;

        if (!erasing && chars >= full) {
          erasing = true;
          timer = window.setTimeout(step, HOLD);
          return;
        }
        if (erasing && chars <= 0) {
          erasing = false;
          entry = (entry + 1) % entries.length;
          chars = 0;
          paint();
          timer = window.setTimeout(step, GAP);
          return;
        }
        chars += erasing ? -1 : 1;
        paint();
        timer = window.setTimeout(step, erasing ? ERASE : TYPE);
      };

      const start = () => {
        window.clearTimeout(timer);
        const [n, label] = entries[entry]!;
        const full = n.length + 1 + label.length;
        // Resume at the cadence of whatever phase we are actually in.
        //
        // A fully-typed entry takes its hold from `step`, which flips to `erasing` and
        // waits HOLD before the first delete. Waiting HOLD here too made that entry sit
        // for two holds. That is always the FIRST entry, because it starts fully typed
        // (server-rendered), so the very statistic everyone sees held ~4s while every
        // later one held ~2s. It also made a return from a hidden tab wait a full 2s
        // even when it was interrupted mid-erase.
        const delay = !erasing && chars >= full ? 0 : erasing ? ERASE : TYPE;
        timer = window.setTimeout(step, delay);
      };
      // Typing into a tab nobody is looking at is pure waste, and the loop would
      // otherwise keep queueing timeouts that browsers throttle but do not stop.
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) window.clearTimeout(timer);
        else start();
      });
      start();
    }
  }
</script>
