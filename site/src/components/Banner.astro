---
// Overrides Starlight's Banner (registered in astro.config.mjs), which the
// layout renders at the top of every page's <main>. It adds the site-wide beta
// notice, then renders Starlight's own Banner, so a page with `banner`
// frontmatter still gets that, unchanged.
//
// Only the homepage skips the strip, because its Hero (src/components/Hero.astro)
// carries the notice inline; BetaNotice.astro says why. The test is the URL
// path, not `hero` frontmatter (Starlight's built-in 404 page sets `hero` too,
// and renders no notice of its own) and not the entry id, which this site's
// custom docs loader assigns differently from Starlight's default.
import Default from '@astrojs/starlight/components/Banner.astro';
import BetaNotice from './BetaNotice.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHomepage = Astro.url.pathname === `${base}/`;
---

{!isHomepage && <BetaNotice variant="strip" />}
<Default />
