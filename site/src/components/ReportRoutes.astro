---
/**
 * ReportRoutes — the body of /report/, the entry-anchored correction page.
 *
 * WHY A PAGE RATHER THAN A LINK STRAIGHT TO GITHUB
 * ------------------------------------------------
 * Sending a card's report link directly to a prefilled GitHub issue is one hop shorter,
 * and for a reader with an account it is strictly better. But a GitHub account is a real
 * exclusion for this audience — a bench scientist in cell ag is meaningfully less likely
 * to hold one than a software reader — and that reader meets a sign-in wall with the
 * entry id stranded behind it. This page is where the id is shown plainly and every route
 * carries it, so no reader is turned away holding a correction they cannot deliver.
 *
 * WHY THE ID IS RESOLVED IN THE BROWSER
 * -------------------------------------
 * The site is static files on GitHub Pages, so `?item=` can only be read client-side.
 * Three consequences the markup below is built around:
 *
 *   1. The query string is attacker-controlled. It is validated against `isItemId` and
 *      then assigned via `textContent` / `href` — never `innerHTML` — so a hostile value
 *      cannot become markup even if the grammar were later loosened.
 *   2. With JavaScript off, nothing resolves. So the page renders the UNANCHORED routes
 *      server-side and the script upgrades them; a no-JS reader gets a working, honest
 *      page rather than an empty one.
 *   3. Cloudflare Web Analytics discards query strings, so page views here are countable
 *      in total but not per entry. The per-entry signal comes from the existing
 *      outbound-click event, which keeps the destination URL.
 *
 * THE COMPOSER, AND WHAT IT DOES NOT FIX
 * --------------------------------------
 * Anchoring a report is not the same as making it easy to write, and until the composer
 * below existed the reader still met a blank textarea at the end of every route. It asks
 * the error class first, then one follow-up drawn from a vocabulary CAAIL already owns —
 * the real matrix rows and columns, the four licence tiers, the eight subject themes — and
 * writes the report itself. Five of the eight error classes need no typing at all.
 *
 * It does NOT fix the GitHub account requirement, and nothing here should imply it does.
 * That is why the composed report is handed to all three routes and not only to GitHub:
 * the email link carries the whole body, and the report is on the page as selectable text
 * for anyone pasting it into Slack. The account wall is unchanged; only the composition is.
 *
 * WHY THE COMPOSER IS SERVER-RENDERED HIDDEN, RATHER THAN NOT RENDERED
 * -------------------------------------------------------------------
 * It is an empty skeleton in the HTML with `hidden` set, and the script fills it and
 * reveals it. Two things fall out of that. A reader with no JavaScript gets precisely the
 * page CAAIL-255 shipped, because the only thing that changed for them is a hidden empty
 * div. And the option lists are built in the browser from the JSON payload below rather
 * than server-rendered as `<option>` elements, so 25 matrix method names do not enter the
 * Pagefind index and make /report/ rank for "Bayesian Optimization".
 *
 * WHERE THE STEP COUNT COMES FROM
 * -------------------------------
 * A reason with no follow-up (a dead link; a paper that is not machine learning at all)
 * has two steps, not three, because there is nothing to ask. Before a reason is picked the
 * total is genuinely unknown, so the heading says "of 3" — the maximum, so the first thing
 * a reader sees can only ever overstate what is left, never understate it.
 *
 * After that the total tracks whatever is currently selected, and it moves in BOTH
 * directions: 3 to 2 on picking a dead link, and back to 3 on changing that to a matrix
 * placement. An earlier version of this comment claimed it only ever shrank, which was
 * simply not true and was reachable in one click. The invariant actually worth having is
 * the narrower one: the count never moves except as a direct result of the reader
 * answering. It does not drift while they are reading a step.
 */
import { COMMUNITY_PATH } from '../lib/community';
import { CORRECTION_EMAIL, correctionIssueUrl, correctionMailto } from '../lib/report';
import { LICENSE_TIERS, TIER_META } from '../lib/licenses';
import correctionForm from '../content/data/correction-form.json';
import papers from '../content/data/papers.json';
import topics from '../content/data/topics.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Unanchored fallbacks. The script replaces both when a valid `?item=` is present.
const issueUrl = correctionIssueUrl(null);
const mailto = correctionMailto(null);

/**
 * Every vocabulary the composer offers, all of it DERIVED.
 *
 * The reasons come from the GitHub issue template this page prefills, the methods and
 * areas are the live matrix axes, the themes are the subject-theme tier, and the tiers are
 * the shared licence classifier's own labels. Nothing here is a list typed beside the file
 * that already knows it — which is the failure mode this repo pays for most often, and the
 * one that would show up here as a reader reporting a correct placement against a row the
 * matrix no longer has.
 */
const vocabularies = {
  reasons: correctionForm.reasons,
  methods: papers.methods,
  areas: papers.areas.map((a) => a.label),
  themes: topics.themes.map((t) => t.label),
  tiers: LICENSE_TIERS.map((t) => TIER_META[t].label),
  // What the review step must say about the GitHub form: the name of the field the reader
  // has to find, and whether it asks for confirmations. Both were written into the copy by
  // hand, which put two facts about entry-correction.yml in the one place a reader sees
  // and nothing checking them — the exact drift this module exists to prevent, reintroduced
  // downstream of it.
  reasonLabel: correctionForm.reasonLabel,
  requiredConfirmations: correctionForm.requiredConfirmations,
};

/**
 * Serialised for a `<script type="application/json">` block.
 *
 * `<` is escaped so no value can close the script element early. Nothing in these
 * vocabularies contains one today; the escape is here so that a future label which does
 * cannot turn a data block into markup.
 */
const vocabJson = JSON.stringify(vocabularies).replace(/</g, '\\u003c');
---

<div class="rp">
  {/* Identified-entry banner. Hidden until the script validates an id, so a reader who
      lands here with no query string, or with a malformed one, never sees an empty slot. */}
  <p class="rp-id" id="caail-report-id" hidden>
    <span class="rp-id-label">This report is about entry</span>
    <code class="rp-id-value" id="caail-report-id-value"></code>
    <button class="rp-copy" id="caail-report-copy" type="button" hidden>Copy</button>
    {/* Announces the copy result. Present from first render so the announcement is not
        the insertion itself, which some screen readers drop. */}
    <span class="rp-copy-status" id="caail-report-copy-status" role="status" aria-live="polite"></span>
  </p>

  {/* Reached with no id from three quite different places: someone who navigated here
      directly; someone following the homepage topics band, whose complaint is about a
      whole subject theme and has no single entry behind it; and someone reading a dataset
      page's inventory table, whose rows carry ids but are deliberately never carded, so
      there is no link for them to have followed. That last group is not a rounding error
      — inventory rows are most of the dataset corpus — and telling them to go back and
      find a link they will never find is exactly the dead end this page exists to avoid.
      So this says what the id buys, where to find one, and what to do when there is none. */}
  <p class="rp-none" id="caail-report-none">
    Every route below works as it is. If your report is about one entry, though, it is much
    quicker to act on when it names that entry: entry cards on the Papers, Software,
    Databases and Datasets pages carry their own
    <span class="rp-nowrap">Report an issue</span> link, which brings the id here with it.
  </p>
  <p class="rp-none" id="caail-report-none-cases">
    Two things have no such link, and need none. Rows in a dataset page's
    <em>Complete data inventory</em> table are listed rather than carded, so quote the
    accession and say which page you saw it on. Reports about a whole subject theme, or
    about the library as a whole, are not about a single entry at all.
  </p>

  {/* The composer. Empty and hidden in the served HTML; the script fills it from the
      payload below and reveals it, but ONLY when a valid entry id resolved. Without an id
      there is no entry for "wrong matrix placement" to be about, and a composer that
      produced an unanchored report would be worse than the prose it replaced.

      data-pagefind-ignore because this is a control, not content: without it the eight
      reason strings and every field label would be indexed, and /report/ would start
      ranking for words it only contains as form furniture. */}
  <section class="rc" id="caail-compose" aria-labelledby="caail-compose-title" hidden data-pagefind-ignore>
    <h2 id="caail-compose-title">Tell us what is wrong</h2>
    {/* "carry it" is claimed only for the two routes that actually do. A link cannot
        prefill a Slack message, so that one is a copy and paste, and saying otherwise
        here would be the same overclaim this page is careful to avoid about accounts. */}
    <p class="rc-lede">
      Two questions at most, answered from lists rather than typed. We write the report for
      you. The GitHub and email routes below carry it as it stands; for Slack you copy it
      across.
    </p>

    {/* Decorative: the same "Step N of M" is in the step heading, which is what a screen
        reader announces when focus moves there, so voicing this too would say it twice. */}
    <div class="rc-track" aria-hidden="true"><i id="caail-compose-track"></i></div>

    <div class="rc-step" id="caail-step-reason">
      <h3 class="rc-h" id="caail-h-reason" tabindex="-1"></h3>
      <fieldset class="rc-fs">
        <legend class="rc-legend" id="caail-compose-legend"></legend>
        <div class="rc-opts" id="caail-compose-reasons"></div>
      </fieldset>
      {/* Empty on first render, so the message IS the change when it appears. An alert
          region that starts populated announces on load and then goes unnoticed. */}
      <p class="rc-err" id="caail-compose-error" role="alert"></p>
    </div>

    <div class="rc-step" id="caail-step-detail" hidden>
      <h3 class="rc-h" id="caail-h-detail" tabindex="-1"></h3>
      <div class="rc-fields" id="caail-compose-fields"></div>
    </div>

    <div class="rc-step" id="caail-step-review" hidden>
      <h3 class="rc-h" id="caail-h-review" tabindex="-1"></h3>
      {/* An answer the composer could not use is DROPPED rather than repaired, because a
          silently corrected report is worse than a shorter one. Dropping it silently is
          worse still: the reader typed a DOI, sees a report that does not mention one, and
          the explanation is back on a step that is no longer on screen. Empty on first
          render so the message is the change when it appears. */}
      <p class="rc-dropped" id="caail-compose-dropped" role="status"></p>
      <p class="rc-review-note" id="caail-compose-dropdown-note"></p>
      <pre class="rc-body" id="caail-compose-body"></pre>
      <p class="rc-actions">
        <button class="rp-copy" id="caail-compose-copy" type="button" hidden>Copy report</button>
        <span class="rp-copy-status" id="caail-compose-copy-status" role="status" aria-live="polite"></span>
      </p>
    </div>

    <div class="rc-nav">
      <button class="rc-btn" id="caail-compose-back" type="button" hidden>Back</button>
      {/* Next is a button because it changes this page. Submit is an ANCHOR because it
          navigates: that keeps middle-click, open-in-new-tab and the browser's own status
          bar working, none of which a button-with-a-click-handler gives you. */}
      <button class="rc-btn rc-primary" id="caail-compose-next" type="button">Next</button>
      <a class="rc-btn rc-primary" id="caail-compose-submit" href={issueUrl} hidden>
        Submit on GitHub
      </a>
    </div>
    <p class="rc-account" id="caail-compose-account" hidden>
      Submitting needs a GitHub account, which this does not change. Without one, the email
      and Slack routes below carry the same report.
    </p>
  </section>

  <script type="application/json" id="caail-compose-vocab" set:html={vocabJson}></script>

  <h2 id="how-to-report">How to report it</h2>

  <p>
    Pick whichever route you already have an account for. They all reach the same person.
    The first two carry the entry id for you; in Slack you paste it in yourself.
  </p>

  <ul class="rp-routes">
    <li>
      <a id="caail-report-github" href={issueUrl}>Open a correction on GitHub</a>
      <span class="rp-note" id="caail-report-github-note">
        Needs a GitHub account. The form is prefilled with the entry id, and the report,
        the discussion and the eventual fix all end up in one public place with a permanent
        link.
      </span>
    </li>
    <li>
      <a id="caail-report-email" href={mailto}>Send an email</a>
      <span class="rp-note" id="caail-report-email-note">
        No account needed. Goes to <code>{CORRECTION_EMAIL}</code>, with the entry id already
        in the subject line.
      </span>
    </li>
    <li>
      <a href={`${base}${COMMUNITY_PATH}`}>Say so in Slack</a>
      <span class="rp-note" id="caail-report-slack-note">
        No GitHub account needed. Paste the entry id into your message so a curator knows
        which entry you mean.
      </span>
    </li>
  </ul>

  <h2 id="what-is-useful">What is useful to say</h2>

  <p>
    Three things: what the entry says now, what it should say instead, and the source for
    that. A curator checks the correction against its source before editing the entry, so
    naming the source is what lets that happen without a search first. A section of the
    paper, the dataset's own documentation, or the repository's licence file will do.
  </p>

  <p>
    Certainty is not a requirement. Every report is checked against the source either way,
    and one that does not hold up changes nothing.
  </p>

  <h2 id="what-happens-next">What happens next</h2>

  <p>
    A curator checks the report against the source and, where it holds up, corrects the entry
    through the library's authoring backend. We do not promise a turnaround time: the review
    path runs through one person, and a schedule we cannot keep is worse than none.
  </p>

  <p>
    CAAIL's curation is openly in progress. It indexes a curated subset rather than a census
    and has not measured its own recall, so a reader who knows a subfield well is often the
    first to notice a specific entry is wrong. That is the signal this page exists to catch.
  </p>
</div>

<script>
  import { isItemId, correctionIssueUrl, correctionMailto } from '../lib/report';
  // Only what this file calls. `boundNote` and `normaliseDoi` are deliberately NOT
  // imported: composeBody applies both itself, and importing them here would invite a
  // second, differently-bounded copy of the same rule at the point of input.
  import {
    NOTE_MAX_LENGTH,
    composeBody,
    isDoiShape,
    type CorrectionAnswers,
    type CorrectionVocabularies,
    type FollowUpKind,
    type ResolvedReason,
  } from '../lib/report-compose';

  /** The three steps, in order. `detail` is skipped when the reason has no follow-up. */
  type StepName = 'reason' | 'detail' | 'review';

  /**
   * What step 2 is called, per follow-up kind.
   *
   * Keyed by the union, so a new kind fails to compile here rather than rendering a step
   * with an empty heading. Declared ABOVE the call to startComposer below, not after it:
   * `const` is in the temporal dead zone until its own line runs, and startComposer paints
   * the first step synchronously. That only failed to throw because the first step has no
   * reason yet and the lookup short-circuits, which is the kind of accident that stops
   * being one the moment a reason is ever preselected.
   */
  const DETAIL_HEADING: Record<FollowUpKind, string> = {
    matrix: 'Where it should sit',
    licence: 'The licence tier it should have',
    topics: 'The subject theme it should have',
    doi: 'The DOI it should have',
    note: 'What it should say',
    none: '',
  };

  const raw = new URLSearchParams(window.location.search).get('item');
  const id = isItemId(raw) ? raw : null;

  const banner = document.getElementById('caail-report-id');
  const value = document.getElementById('caail-report-id-value');
  // Both no-id paragraphs, so neither is left behind when an entry resolves.
  const none = document.querySelectorAll('.rp-none');
  const gh = document.getElementById('caail-report-github') as HTMLAnchorElement | null;
  const mail = document.getElementById('caail-report-email') as HTMLAnchorElement | null;
  const copy = document.getElementById('caail-report-copy') as HTMLButtonElement | null;
  const status = document.getElementById('caail-report-copy-status');

  /**
   * Re-announcing needs the region to CHANGE, and a second copy writes the same string as
   * the first, so without clearing it a screen-reader user hears nothing the second time.
   * src/lib/tabs.ts solves it the same way, and homepage-agent.spec.ts has a regression
   * test named for exactly this.
   */
  function announcer(region: HTMLElement | null) {
    let clear: number | undefined;
    return (msg: string) => {
      if (!region) return;
      if (clear !== undefined) window.clearTimeout(clear);
      region.textContent = msg;
      clear = window.setTimeout(() => {
        region.textContent = '';
        clear = undefined;
      }, 2000);
    };
  }

  /**
   * Wire a copy button to a string it reads at click time.
   *
   * The button stays hidden where the Clipboard API is unavailable rather than failing on
   * click: in both places it is used the text is selectable on the page anyway, so the
   * button is pure enhancement and its absence costs nothing.
   */
  function wireCopy(
    button: HTMLButtonElement | null,
    region: HTMLElement | null,
    read: () => string,
    label: string,
  ) {
    if (!button || !navigator.clipboard) return;
    const announce = announcer(region);
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(read());
        announce(`${label} copied.`);
      } catch {
        announce(`Could not copy. Select the ${label.toLowerCase()} and copy it manually.`);
      }
    });
  }

  if (id) {
    // textContent, never innerHTML: `id` has passed the grammar check, and this keeps it
    // inert regardless of what that grammar is later widened to admit.
    if (value) value.textContent = id;
    if (banner) banner.hidden = false;
    none.forEach((el) => { (el as HTMLElement).hidden = true; });
    if (gh) gh.href = correctionIssueUrl(id);
    if (mail) mail.href = correctionMailto(id);
    wireCopy(copy, status, () => id, 'Entry id');

    startComposer(id);
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // The composer
  // ─────────────────────────────────────────────────────────────────────────────

  function startComposer(itemId: string) {
    const section = document.getElementById('caail-compose');
    const payload = document.getElementById('caail-compose-vocab');
    if (!section || !payload?.textContent) return;

    const vocab = JSON.parse(payload.textContent) as CorrectionVocabularies & {
      reasons: ResolvedReason[];
      /** The GitHub form's own name for the reason field, and its confirmation count. */
      reasonLabel: string;
      requiredConfirmations: number;
    };

    const el = {
      track: document.getElementById('caail-compose-track'),
      legend: document.getElementById('caail-compose-legend'),
      reasons: document.getElementById('caail-compose-reasons'),
      error: document.getElementById('caail-compose-error'),
      fields: document.getElementById('caail-compose-fields'),
      body: document.getElementById('caail-compose-body'),
      dropdownNote: document.getElementById('caail-compose-dropdown-note'),
      dropped: document.getElementById('caail-compose-dropped'),
      account: document.getElementById('caail-compose-account'),
      back: document.getElementById('caail-compose-back') as HTMLButtonElement | null,
      next: document.getElementById('caail-compose-next') as HTMLButtonElement | null,
      submit: document.getElementById('caail-compose-submit') as HTMLAnchorElement | null,
      copy: document.getElementById('caail-compose-copy') as HTMLButtonElement | null,
      copyStatus: document.getElementById('caail-compose-copy-status'),
      ghNote: document.getElementById('caail-report-github-note'),
      mailNote: document.getElementById('caail-report-email-note'),
      slackNote: document.getElementById('caail-report-slack-note'),
    };

    const heading: Record<StepName, HTMLElement | null> = {
      reason: document.getElementById('caail-h-reason'),
      detail: document.getElementById('caail-h-detail'),
      review: document.getElementById('caail-h-review'),
    };
    const panel: Record<StepName, HTMLElement | null> = {
      reason: document.getElementById('caail-step-reason'),
      detail: document.getElementById('caail-step-detail'),
      review: document.getElementById('caail-step-review'),
    };

    /**
     * Typed as CorrectionAnswers itself rather than cast to it at the call site. The cast
     * was hiding a missing `itemId`, so every composed report opened "Entry: undefined" —
     * the one line the whole feature exists to carry.
     */
    const answers: {
      -readonly [K in keyof CorrectionAnswers]: CorrectionAnswers[K];
    } & { method: string; area: string; tier: string; theme: string; doi: string; note: string } = {
      itemId,
      reason: null,
      method: '',
      area: '',
      tier: '',
      theme: '',
      doi: '',
      note: '',
    };

    let current: StepName = 'reason';
    /** Pending re-post of the step-1 alert. Held so it can be cancelled; see `alert`. */
    let alertTimer: number | undefined;

    /**
     * The three route notes are rewritten once, the moment a report first exists, and the
     * email one is built from the address the page already renders rather than a second
     * copy of the constant. Read here, before anything overwrites the element it lives in.
     */
    const mailAddress =
      document.querySelector('#caail-report-email-note code')?.textContent ?? '';
    let routeNotesRewritten = false;

    /** The steps this reason actually needs. Three at most, two when nothing to ask. */
    function plan(): StepName[] {
      if (answers.reason && answers.reason.kind !== 'none') return ['reason', 'detail', 'review'];
      if (answers.reason) return ['reason', 'review'];
      // Unknown until a reason is picked, so assume the maximum: an opening guess can then
      // only overstate what is left, never understate it. It does NOT stay the maximum —
      // the total follows the current answer and moves both ways. See the file header.
      return ['reason', 'detail', 'review'];
    }

    function body(): string {
      return composeBody(answers, vocab);
    }

    // ── rendering ─────────────────────────────────────────────────────────────

    function buildReasons() {
      if (!el.reasons) return;
      vocab.reasons.forEach((reason, i) => {
        const label = document.createElement('label');
        label.className = 'rc-opt';

        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'caail-reason';
        input.id = `caail-reason-${i}`;
        // The index, not the option string: the value never leaves this page, and an
        // index cannot be mistaken by a later reader for something that gets submitted.
        input.value = String(i);

        const text = document.createElement('span');
        const strong = document.createElement('span');
        strong.className = 'rc-opt-label';
        strong.textContent = reason.label;
        text.appendChild(strong);
        if (reason.hint) {
          const hint = document.createElement('span');
          hint.className = 'rc-opt-hint';
          hint.textContent = reason.hint;
          text.appendChild(hint);
        }

        input.addEventListener('change', () => {
          answers.reason = reason;
          // Clear every follow-up answer: they belong to the previous reason, and a stale
          // one would be composed into a report about a different error class.
          answers.method = answers.area = answers.tier = '';
          answers.theme = answers.doi = answers.note = '';
          clearAlert();
          buildFields();
          // Picking a reason is the ONLY thing that changes the step plan, and until it is
          // picked the total is a guess. Repaint the current step so the count corrects
          // itself before the reader can act on it. `false`: no focus move, because the
          // reader is mid-choice in the radio group and yanking focus to the heading would
          // interrupt them.
          show(current, false);
          render();
        });

        label.append(input, text);
        el.reasons!.appendChild(label);
      });
    }

    /** A labelled `<select>` over one live vocabulary. */
    function selectField(
      id: string,
      labelText: string,
      options: readonly string[],
      placeholder: string,
      read: () => string,
      write: (v: string) => void,
    ): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'rc-field';

      const label = document.createElement('label');
      label.htmlFor = id;
      label.textContent = labelText;

      const select = document.createElement('select');
      select.id = id;
      const blank = document.createElement('option');
      blank.value = '';
      blank.textContent = placeholder;
      select.appendChild(blank);
      for (const option of options) {
        const node = document.createElement('option');
        node.value = option;
        node.textContent = option;
        select.appendChild(node);
      }
      select.value = read();
      select.addEventListener('change', () => {
        write(select.value);
        render();
      });

      wrap.append(label, select);
      return wrap;
    }

    function buildFields() {
      if (!el.fields) return;
      el.fields.replaceChildren();
      const reason = answers.reason;
      if (!reason) return;

      if (reason.kind === 'matrix') {
        el.fields.append(
          selectField(
            'caail-f-method', 'AI/ML method it should be', vocab.methods,
            'Choose a method', () => answers.method, (v) => { answers.method = v; },
          ),
          selectField(
            'caail-f-area', 'Research area it should be', vocab.areas,
            'Choose an area', () => answers.area, (v) => { answers.area = v; },
          ),
        );
      } else if (reason.kind === 'licence') {
        el.fields.append(selectField(
          'caail-f-tier', 'Licence tier it should be', vocab.tiers,
          'Choose a tier', () => answers.tier, (v) => { answers.tier = v; },
        ));
      } else if (reason.kind === 'topics') {
        el.fields.append(selectField(
          'caail-f-theme', 'Subject theme it should be', vocab.themes,
          'Choose a theme', () => answers.theme, (v) => { answers.theme = v; },
        ));
      } else if (reason.kind === 'doi') {
        el.fields.appendChild(doiField());
      } else if (reason.kind === 'note') {
        el.fields.appendChild(noteField(reason.noteLabel ?? 'What it should say'));
      }
    }

    function doiField(): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'rc-field';

      const label = document.createElement('label');
      label.htmlFor = 'caail-f-doi';
      label.textContent = 'The DOI it should have';

      const input = document.createElement('input');
      input.type = 'text';
      input.id = 'caail-f-doi';
      input.placeholder = '10.1016/j.scitotenv.2023.164988';
      // Bounded at the point of entry as well as in the shape check, so a paste of a whole
      // article body cannot sit in the field looking like a pending answer. The value is
      // still re-checked in composeBody: this is the affordance, not the guarantee.
      input.maxLength = 200;
      input.value = answers.doi;
      input.setAttribute('aria-describedby', 'caail-f-doi-help caail-f-doi-err');

      const help = document.createElement('span');
      help.className = 'rc-help';
      help.id = 'caail-f-doi-help';
      help.textContent = 'A doi.org address works too; we trim it down.';

      // role=alert rather than a static hint, so the message is announced when the shape
      // check starts failing rather than read out on every visit to this step.
      const error = document.createElement('span');
      error.className = 'rc-err';
      error.id = 'caail-f-doi-err';
      error.setAttribute('role', 'alert');

      input.addEventListener('input', () => {
        answers.doi = input.value;
        const typed = input.value.trim();
        const ok = typed === '' || isDoiShape(typed);
        error.textContent = ok
          ? ''
          : 'That does not look like a DOI. One starts with "10." and contains a slash.';
        input.setAttribute('aria-invalid', ok ? 'false' : 'true');
        render();
      });

      wrap.append(label, input, help, error);
      return wrap;
    }

    function noteField(labelText: string): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'rc-field';

      const label = document.createElement('label');
      label.htmlFor = 'caail-f-note';
      label.textContent = `${labelText} (optional)`;

      const area = document.createElement('textarea');
      area.id = 'caail-f-note';
      area.maxLength = NOTE_MAX_LENGTH;
      area.rows = 3;
      area.value = answers.note;
      area.setAttribute('aria-describedby', 'caail-f-note-count');

      // Not a live region: it would announce on every keystroke. The cap is also enforced
      // by maxLength and again by boundNote, so this is a convenience readout.
      const count = document.createElement('span');
      count.className = 'rc-help';
      count.id = 'caail-f-note-count';
      const paint = () => {
        count.textContent = `${area.value.length} of ${NOTE_MAX_LENGTH} characters`;
      };
      paint();

      area.addEventListener('input', () => {
        answers.note = area.value;
        paint();
        render();
      });

      wrap.append(label, area, count);
      return wrap;
    }

    // ── step machinery ────────────────────────────────────────────────────────

    function show(step: StepName, moveFocus: boolean) {
      const steps = plan();
      const index = steps.indexOf(step);
      current = step;

      for (const name of ['reason', 'detail', 'review'] as StepName[]) {
        const node = panel[name];
        if (node) node.hidden = name !== step;
      }

      // The count lives in the heading rather than in a separate live region, so moving
      // focus here announces the position and the question in one breath instead of two.
      const position = `Step ${index + 1} of ${steps.length}`;
      const titles: Record<StepName, string> = {
        reason: 'What is wrong with it?',
        detail: answers.reason ? DETAIL_HEADING[answers.reason.kind] : '',
        review: 'Your report',
      };
      const node = heading[step];
      if (node) node.textContent = `${position}: ${titles[step]}`;
      // The fieldset's legend repeats the question for the radio group. Kept in step with
      // the heading rather than written twice.
      if (el.legend) el.legend.textContent = titles.reason;

      if (el.track) el.track.style.transform = `scaleX(${(index + 1) / steps.length})`;

      if (el.back) el.back.hidden = index === 0;
      if (el.next) el.next.hidden = step === 'review';
      if (el.submit) el.submit.hidden = step !== 'review';
      if (el.account) el.account.hidden = step !== 'review';

      // Focus moves only on a deliberate step change, never on the first paint: stealing
      // focus on load would drop a keyboard reader into the middle of the page.
      if (moveFocus && node) node.focus();
    }

    function go(delta: 1 | -1) {
      const steps = plan();
      const index = steps.indexOf(current);
      const next = steps[index + delta];
      if (next) show(next, true);
    }

    // ── live output ───────────────────────────────────────────────────────────

    function render() {
      const composed = body();

      if (el.body) {
        el.body.textContent = composed;
        // A pre with no content collapses to nothing and reads as a rendering fault.
        el.body.hidden = composed === '';
      }

      // Every route gets the composed body. The GitHub link is updated even while the
      // reader is mid-wizard, so bailing out to it early still carries whatever has been
      // answered so far rather than dropping it.
      if (gh) gh.href = correctionIssueUrl(itemId, composed);
      if (mail) mail.href = correctionMailto(itemId, composed);
      if (el.submit) el.submit.href = correctionIssueUrl(itemId, composed);

      if (el.dropped) {
        // Only the DOI can reach this by ordinary use. An out-of-vocabulary select value
        // is dropped by composeBody the same way, but getting one requires editing the
        // DOM, and a reader who has done that does not need telling.
        //
        // Deliberately NOT a block on Next. Refusing to advance would trap a reader who
        // cannot find the DOI and typed something wrong: the way out would be to work out
        // that emptying the field is allowed. Saying what happened and letting them send
        // it is the honest version, and an incomplete report still beats no report.
        const typed = (answers.doi ?? '').trim();
        el.dropped.textContent =
          answers.reason?.kind === 'doi' && typed !== '' && !isDoiShape(typed)
            ? 'What you typed is not shaped like a DOI, so it is not in the report below. Go back to change it, or send the report as it stands.'
            : '';
      }

      if (el.dropdownNote) {
        // `value`, not `label`: this tells the reader which entry to find in a dropdown,
        // so it has to be the option verbatim. The label is the display split and would
        // only ever be a prefix of what they are looking at.
        //
        // The field name and the confirmations both come from the template, not from this
        // sentence. A reader told that one dropdown was all that remained would meet a form
        // refusing to submit for reasons this page had implied were handled, and a reworded
        // `label:` would send every reader looking for a field that no longer exists.
        // Phrased without a numeral so the count cannot go stale either: a form with no
        // required confirmations simply stops mentioning them.
        const confirmations =
          vocab.requiredConfirmations > 0 ? ', and tick the confirmations' : '';
        el.dropdownNote.textContent = answers.reason
          ? `Your report is filled in for you on GitHub. What is left there: pick "${answers.reason.value}" under "${vocab.reasonLabel}"${confirmations}.`
          : '';
      }

      // Rewritten once, when a report first exists, rather than on every render: the
      // email note's replacement text is built from `mailAddress`, which is read out of
      // the note's own markup and would be gone the second time round.
      if (composed && !routeNotesRewritten) {
        routeNotesRewritten = true;
        if (el.ghNote) {
          el.ghNote.textContent =
            'Needs a GitHub account. The form opens with your report already written into it, and the report, the discussion and the eventual fix all end up in one public place with a permanent link.';
        }
        if (el.mailNote) {
          // Rebuilt as nodes rather than assigned as text, so the address keeps its <code>
          // treatment. Writing textContent here destroyed the element the address is
          // rendered in, and because this block latches it could never come back: the
          // moment a report first composed, the email address silently lost its monospace
          // styling for the rest of the visit.
          const address = document.createElement('code');
          address.textContent = mailAddress;
          el.mailNote.replaceChildren(
            document.createTextNode(
              'No account needed. Opens your mail app with the whole report already written, addressed to ',
            ),
            address,
            document.createTextNode('.'),
          );
        }
        if (el.slackNote) {
          el.slackNote.textContent =
            'No GitHub account needed. Copy the report from the last step and paste it into your message.';
        }
      }
    }

    // ── wiring ────────────────────────────────────────────────────────────────

    /**
     * Put a message in the `role="alert"` region so it is announced EVERY time.
     *
     * `role=alert` fires on a content change, so writing the same string twice announces
     * once: a reader who presses Next with nothing selected, then presses it again, hears
     * the reason the first time and silence the second. Clearing first makes the rewrite a
     * change. Only when the text is identical, so the common case does not flicker.
     *
     * Not the `announcer` helper above, despite the same underlying problem: that one
     * clears the region after two seconds, which is right for a transient "copied" status
     * and wrong for a validation error that must stay on screen until it is fixed.
     */
    function alert(message: string) {
      const region = el.error;
      if (!region) return;
      // Read BEFORE clearing. `clearAlert` empties the region, so comparing after it
      // compares against '' and is therefore always true: the early return below fires
      // every time and the re-post can never arm. That is how the timer-cancel guard
      // added in one round silently reverted the re-announce fix added in the one before,
      // while the test written for it went on passing against a code path that no longer
      // existed.
      const previous = region.textContent;
      clearAlert();
      if (previous !== message) {
        region.textContent = message;
        return;
      }
      alertTimer = window.setTimeout(() => {
        region.textContent = message;
        alertTimer = undefined;
      }, 60);
    }

    /**
     * Drop the alert, INCLUDING a re-post that has been armed but not yet fired.
     *
     * Without cancelling the timer the message comes back from the dead: press Next twice
     * with nothing selected (arming the 60ms re-post), then answer the question inside that
     * window, and the timer repaints "Pick what is wrong with the entry to continue" over a
     * step the reader has already satisfied. Nothing would clear it for the rest of the
     * flow, so the contradiction just sits there.
     */
    function clearAlert() {
      if (alertTimer !== undefined) {
        window.clearTimeout(alertTimer);
        alertTimer = undefined;
      }
      if (el.error) el.error.textContent = '';
    }

    el.next?.addEventListener('click', () => {
      if (current === 'reason' && !answers.reason) {
        // Deliberately not a disabled button: a disabled control cannot be focused, so a
        // keyboard reader who tabs to it gets no explanation of why nothing happens.
        alert('Pick what is wrong with the entry to continue.');
        (el.reasons?.querySelector('input') as HTMLInputElement | null)?.focus();
        return;
      }
      go(1);
    });
    el.back?.addEventListener('click', () => go(-1));

    wireCopy(el.copy, el.copyStatus, body, 'Report');

    buildReasons();
    show('reason', false);
    render();
    section.hidden = false;
  }
</script>

