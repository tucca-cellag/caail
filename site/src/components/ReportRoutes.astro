    background: var(--caail-link);
    transition: transform 0.18s ease;
  }
  /* Honour a reader who has asked the OS for less motion. The fill still moves; it just
     stops sliding there. */
  @media (prefers-reduced-motion: reduce) {
    .rc-track > i {
      transition: none;
    }
  }

  .rc-h {
    font-size: 1.05rem;
    margin-block: 0 0.75rem;
  }
  /* The step headings are focus targets (tabindex="-1"), so they need a visible ring:
     moving focus somewhere invisible is worse than not moving it. */
  .rc-h:focus-visible {
    outline: 2px solid var(--caail-link);
    outline-offset: 3px;
    border-radius: 0.2rem;
  }

  .rc-fs {
    border: 0;
    margin: 0;
    padding: 0;
    min-inline-size: 0;
  }
  /* The legend repeats the step heading, which is the right thing for the radio group's
     accessible name and the wrong thing to show twice on screen. */
  .rc-legend {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
