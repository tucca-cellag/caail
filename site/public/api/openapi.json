{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "CAAIL agent API",
    "version": "2026-08-11",
    "summary": "Static JSON endpoints describing the Cellular Agriculture AI Library.",
    "description": "Seven static JSON files, served by GET, with nothing to install or authenticate. Generated from the same schemas that validate the payloads, in the same build step that writes them. The paths below are absolute on the GitHub Pages origin, https://tucca-cellag.github.io. The same files are mirrored per-filename at https://raw.githubusercontent.com/tucca-cellag/caail/main/site/public/api/, which some clients can reach when Pages is not allow-listed. Resolve that mirror by filename; do not join the paths below onto it.",
    "license": {
      "name": "MIT (CAAIL curation). Linked third-party resources keep their own licenses.",
      "identifier": "MIT"
    }
  },
  "x-corpus-date": "2026-08-11",
  "paths": {
    "/caail/api/index.json": {
      "get": {
        "operationId": "getManifest",
        "summary": "Corpus manifest",
        "description": "Read first. Corpus date, the endpoint list, a pointer to this document, and counts labelled with the population each one counted.",
        "responses": {
          "200": {
            "description": "Corpus manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Manifest"
                }
              }
            }
          }
        }
      }
    },
    "/caail/api/matrix.json": {
      "get": {
        "operationId": "getMatrix",
        "summary": "The complete AI-method × research-area grid",
        "description": "All method×area cells, INCLUDING those with no indexed paper. papers.json carries only the populated ones, so this is the only endpoint that distinguishes \"no paper here\" from \"I did not find one\". Every empty cell carries its own scope caveat: absence in this corpus is not absence in the literature.",
        "responses": {
          "200": {
            "description": "The complete AI-method × research-area grid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Matrix"
                }
              }
            }
          }
        }
      }
    },
    "/caail/api/papers.json": {
      "get": {
        "operationId": "getPapers",
        "summary": "Every reference",
        "description": "DOI, code URL, data URL, topics, license and citation count per reference. Spans six sections; only References is matrix-eligible, so say which population you counted.",
        "responses": {
          "200": {
            "description": "Every reference",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Papers"
                }
              }
            }
          }
        }
      }
    },
    "/caail/api/catalog.json": {
      "get": {
        "operationId": "getCatalog",
        "summary": "Software and databases",
        "description": "Open-source tools and query/lookup resources, with topic, license tier and DOI.",
        "responses": {
          "200": {
            "description": "Software and databases",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          }
        }
      }
    },
    "/caail/api/datasets.json": {
      "get": {
        "operationId": "getDatasets",
        "summary": "Curated dataset entries and per-species inventory",
        "description": "Two arrays. `entries` are the curated portals, atlases and GEMs. `inventory` are the per-study deposits — accession, assay type, tissue, size — keyed by the source page's own column labels, since the tables differ per page. Filter either by `page`. Use `inventory` for \"what could I combine my own run with\".",
        "responses": {
          "200": {
            "description": "Curated dataset entries and per-species inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Datasets"
                }
              }
            }
          }
        }
      }
    },
    "/caail/api/topics.json": {
      "get": {
        "operationId": "getTopics",
        "summary": "Subject tree and inverted index",
        "description": "The theme→tag tree is under `tree`; the inverted index (topic slug → item ids across papers, software, databases and datasets) is under `index`. There is no top-level `themes` or `tags`. Start here for \"what should I use for X\".",
        "responses": {
          "200": {
            "description": "Subject tree and inverted index",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Topics"
                }
              }
            }
          }
        }
      }
    },
    "/caail/api/taxonomy.json": {
      "get": {
        "operationId": "getTaxonomy",
        "summary": "What each method and area means in CAAIL",
        "description": "CAAIL's own definition of every matrix row and column, with exclusion criteria. Read before trusting or disputing a placement.",
        "responses": {
          "200": {
            "description": "What each method and area means in CAAIL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Taxonomy"
                }
              }
            }
          }
        }
      }
    }
  },
