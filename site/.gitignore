# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Playwright test artifacts
test-results/
playwright-report/
playwright/.cache/

# Lighthouse CI reports (generated by `lhci autorun`)
.lighthouseci/

# Generated full-text agent index (regenerated by `pnpm parse`)
public/llms-full.txt

# SQLite authoring DB — gitignored build artifact, rebuilt from the committed
# NDJSON source (site/db/ndjson/) by `pnpm db:build`. The NDJSON is the tracked
# source of truth; the .db never lands in git.
caail.db
caail.db-journal
caail.db-wal
caail.db-shm

# Generated parser output (regenerated by `pnpm parse`).
#
# A glob, not a list of twelve names. Every file the parser writes here is generated, and
# the enumeration had to be extended by hand each time generate-data.ts learned to emit
# one more — so the failure mode was silent in the direction that costs: a new artifact is
# simply not ignored, `git add -A` tracks it, and a build output starts drifting against
# the source it is generated from with nothing to say so. That happened to
# correction-form.json, the thirteenth.
#
# Safe because nothing under this directory is hand-authored. If that ever stops being
# true, negate the one exception here rather than going back to a list.
src/content/data/*.json
